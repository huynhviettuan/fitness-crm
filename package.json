{
  "name": "flow-fitness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "test:e2e": "turbo run test:e2e",
    "test:security": "turbo run test:security",
    "db:up": "docker compose up -d --wait",
    "db:migrate": "pnpm --filter api db:migrate",
    "db:deploy": "pnpm --filter api db:deploy",
    "db:seed": "pnpm --filter api db:seed",
    "db:seed:demo": "pnpm --filter api db:seed:demo",
    "db:seed:bulk": "pnpm --filter api db:seed:bulk",
    "security:audit": "node scripts/audit-check.mjs"
  },
  "devDependencies": {
    "prettier": "3.9.9",
    "prettier-plugin-tailwindcss": "0.8.1",
    "turbo": "2.11.4"
  },
  "engines": {
    "node": ">=22"
  }
}
