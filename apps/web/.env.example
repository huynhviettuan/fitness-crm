# Copy to apps/web/.env for local development: cp apps/web/.env.example apps/web/.env
# Every value here is for LOCAL DEVELOPMENT ONLY. Never use them in a deployed environment.

# Where the web server reaches the API (apps/api). Browsers never call it directly:
# they use this app's /api/* routes, which forward to it (T-053).
API_URL="http://localhost:4000"

# Gym timezone (A-001), for showing dates and times.
GYM_TIMEZONE="Asia/Ho_Chi_Minh"

# Hours the PT calendar shows by default; bookings outside them are still shown.
SCHEDULE_START_HOUR="6"
SCHEDULE_END_HOUR="22"
