{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "openapi": "node dist/openapi.js",
    "openapi:check": "node dist/openapi.js --check",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:seed:demo": "tsx prisma/seed-demo.ts"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@flow/shared": "workspace:*",
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-express": "^12.1.2",
    "@nestjs/swagger": "^12.0.2",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "better-auth": "^1.7.7",
    "dotenv": "^18.0.6",
    "pg": "^8.23.1",
    "pg-boss": "^12.19.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@flow/config": "workspace:*",
    "@nestjs/cli": "^12.0.8",
    "@types/express": "^5.0.3",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "eslint": "^9.39.5",
    "prisma": "^7.10.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
