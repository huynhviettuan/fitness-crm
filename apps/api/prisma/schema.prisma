// Data model: docs/04_DATA_MODEL_ERD.md
// Tables and columns are snake_case so raw SQL (row locks, constraints) stays readable.
// All datetime columns are timestamptz (docs/04 "Time").

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  // ES modules with .js import paths, as Node.js and `tsc --module nodenext` expect.
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// D-017: a role's reach per resource: everything in the user's branches, or only the
// records the user is responsible for.
enum DataScope {
  ALL
  OWN
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum Locale {
  vi
  en
}

// Stored contract statuses; EXPIRED is derived from end_date (T-018).
// DRAFT is "pending approval" (A-120); REJECTED was turned down by the approver (A-121).
enum ContractStatus {
  DRAFT
  ACTIVE
  CANCELLED
  REJECTED
  // Deactivated for review (D-023): no booking, no check-in, and no expiry while it lasts.
  FROZEN
}

// D-019: one record per person; a lead becomes a customer at Show.
enum PersonStage {
  LEAD
  CUSTOMER
}

// D-020, brief §3.
enum LeadStatus {
  NEW
  CONSULTING
  CONSIDERING
  NO_RESPONSE
  BOOKED
  SHOWED
  NO_SHOW
  REFUSED
  CONTRACTED
}

// What opens a consulting step (D-020, packages/shared/src/leads/checklist.schema.ts).
enum StepTrigger {
  ASSIGNED
  STATUS
  APPOINTMENT
  AFTER_STEP
  RECARE
}

enum StepTiming {
  ON_TIME
  LATE
}

// What the system does when a consulting step is done (packages/shared/src/leads/checklist.schema.ts).
enum StepAction {
  STUDIO_TASK
}

// Citizen ID card or passport (brief §3 stage 3).
enum IdDocumentType {
  CCCD
  PASSPORT
}

enum SourceType {
  ORGANIC
  PAID
}

enum NationalityGroup {
  VIETNAM
  FOREIGN
}

// A-013
enum CustomerStatus {
  ACTIVE
  INACTIVE
}

// Working status (brief §8.4): an employee who left keeps their history but takes no
// new bookings.
enum EmployeeStatus {
  ACTIVE
  INACTIVE
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

// The booking owns the single lifecycle status (T-011).
// D-018: a request moves from PENDING to APPROVED or REJECTED by someone other than
// its submitter, or is CANCELLED when its record goes away. Records that can need
// approval use PENDING, APPROVED, and REJECTED, and count only when APPROVED.
enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

// Brief §8.2: the assignee accepts; DONE and CANCELLED are final.
enum TaskStatus {
  NEW
  ACCEPTED
  IN_PROGRESS
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
}

enum CashTransactionType {
  INCOME
  EXPENSE
}

// ---------------------------------------------------------------------------
// Identity. The User, AuthSession, AuthAccount, AuthVerification and
// AuthRateLimit shapes are dictated by Better Auth (T-028).
// ---------------------------------------------------------------------------

model User {
  id            String     @id @default(uuid()) @db.Uuid
  name          String
  email         String     @unique
  emailVerified Boolean    @default(false) @map("email_verified")
  image         String?
  roleId        String     @map("role_id") @db.Uuid
  role          Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  // D-014: every branch, including ones created later; otherwise the granted branches.
  allBranches   Boolean    @default(false) @map("all_branches")
  status        UserStatus @default(ACTIVE)
  locale        Locale     @default(vi)
  // D-050: the turn weight of a consultant (initially 1) and whether they receive leads now (leave, busy).
  leadWeight    Int        @default(1) @map("lead_weight")
  receivesLeads Boolean    @default(true) @map("receives_leads")
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions              AuthSession[]
  accounts              AuthAccount[]
  auditEvents           AuditEvent[]
  contractsCreated      Contract[]               @relation("ContractCreatedBy")
  contractsApproved     Contract[]               @relation("ContractApprovedBy")
  contractsDeleted      Contract[]               @relation("ContractDeletedBy")
  freezesStarted        ContractFreeze[]         @relation("FreezeStartedBy")
  freezesEnded          ContractFreeze[]         @relation("FreezeEndedBy")
  // Brief §8.4: the employee this login belongs to, at most one.
  employee              Employee?
  sessionsCheckedIn     Session[]                @relation("SessionCheckedInBy")
  sessionsCompleted     Session[]                @relation("SessionCompletedBy")
  paymentsRecorded      Payment[]                @relation("PaymentCreatedBy")
  paymentsDeleted       Payment[]                @relation("PaymentDeletedBy")
  cashRecorded          CashTransaction[]        @relation("CashTransactionCreatedBy")
  cashOpeningsSet       CashOpeningBalance[]     @relation("CashOpeningUpdatedBy")
  filesUploaded         StoredFile[]             @relation("FileUploadedBy")
  bookingStatusesSet    Booking[]                @relation("BookingStatusSetBy")
  bookingHistoryDeletes Booking[]                @relation("BookingHistoryDeletedBy")
  cashDeleted           CashTransaction[]        @relation("CashTransactionDeletedBy")
  trashEntries          TrashEntry[]
  approvalsSubmitted    ApprovalRequest[]        @relation("ApprovalSubmittedBy")
  approvalsDecided      ApprovalRequest[]        @relation("ApprovalDecidedBy")
  customersCreated      Customer[]
  leadsInCharge         Customer[]               @relation("PersonPic")
  dataConsentsTaken     Customer[]               @relation("PersonDataConsent")
  branches              UserBranch[]
  overrides             UserPermissionOverride[]
  accessWindows         UserAccessWindow[]
  loginEvents           LoginEvent[]
  leadTurns             LeadTurn[]
  tasksAssigned         Task[]                   @relation("TaskAssigner")
  tasksReceived         Task[]                   @relation("TaskAssignee")
  taskComments          TaskComment[]
  notifications         Notification[]
  emailsCaused          EmailMessage[]           @relation("EmailCreatedBy")
  priceTierVersions     PriceTierVersion[]       @relation("PriceTierVersionCreatedBy")
  leadStatusChanges     LeadStatusChange[]
  leadAssignedFrom      LeadAssignment[]         @relation("LeadAssignmentFrom")
  leadAssignedTo        LeadAssignment[]         @relation("LeadAssignmentTo")
  leadAssignedBy        LeadAssignment[]         @relation("LeadAssignmentBy")
  leadRoundRobins       LeadRoundRobin[]
  leadStepsDone         LeadStep[]
  leadInquiries         LeadInquiry[]
  leadNotes             LeadNote[]               @relation("LeadNoteAuthor")
  consultingAudits      ConsultingAudit[]        @relation("ConsultingAuditor")
  personMerges          PersonMerge[]
  classEnrollments      ClassAttendance[]        @relation("ClassEnrolledBy")
  classMarks            ClassAttendance[]        @relation("ClassMarkedBy")

  @@index([roleId])
  @@map("users")
}

// ---------------------------------------------------------------------------
// Branches, roles, and permissions (D-014, D-017, T-046). Permission keys, data-scope
// resources, and maskable fields are a catalog in @flow/shared; rows here configure them.
// ---------------------------------------------------------------------------

model Branch {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  address   String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  users            UserBranch[]
  customers        Customer[]
  contracts        Contract[]
  employees        Employee[]
  bookings         Booking[]
  checkinDevices   CheckinDevice[]
  payments         Payment[]
  cashTransactions CashTransaction[]
  cashOpenings     CashOpeningBalance[]
  trashEntries     TrashEntry[]
  approvalRequests ApprovalRequest[]
  tasks            Task[]
  emails           EmailMessage[]
  serviceBranches  ServiceBranch[]
  leadRoundRobin   LeadRoundRobin?
  leadTurns        LeadTurn[]
  leadInquiries    LeadInquiry[]

  classes       GymClass[]
  classSessions ClassSession[]

  @@map("branches")
}

model Role {
  id                   String   @id @default(uuid()) @db.Uuid
  // Set on the default roles (09_RBAC.md) so code and tests can find them; null for
  // roles admin creates. Never shown to users.
  code                 String?  @unique
  name                 String   @unique
  description          String?
  // The largest discount, as a percent of the tier price, holders may approve themselves (A-112).
  discountThresholdPct Decimal  @default(0) @map("discount_threshold_pct") @db.Decimal(5, 2)
  clonedFromId         String?  @map("cloned_from_id") @db.Uuid
  clonedFrom           Role?    @relation("RoleClones", fields: [clonedFromId], references: [id], onDelete: SetNull)
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  clones        Role[]             @relation("RoleClones")
  users         User[]
  approvalRules ApprovalRuleRole[]
  permissions   RolePermission[]
  dataScopes    RoleDataScope[]
  fieldMasks    RoleFieldMask[]

  @@map("roles")
}

model RolePermission {
  roleId     String @map("role_id") @db.Uuid
  role       Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission String

  @@id([roleId, permission])
  @@map("role_permissions")
}

// A resource without a row is OWN: a new resource is closed until admin opens it.
model RoleDataScope {
  roleId   String    @map("role_id") @db.Uuid
  role     Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  resource String
  scope    DataScope

  @@id([roleId, resource])
  @@map("role_data_scopes")
}

model RoleFieldMask {
  roleId String @map("role_id") @db.Uuid
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  field  String

  @@id([roleId, field])
  @@map("role_field_masks")
}

// A user inherits the role and can have single permissions switched on or off.
model UserPermissionOverride {
  userId     String  @map("user_id") @db.Uuid
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission String
  granted    Boolean

  @@id([userId, permission])
  @@map("user_permission_overrides")
}

model UserBranch {
  userId   String @map("user_id") @db.Uuid
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branchId String @map("branch_id") @db.Uuid
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@id([userId, branchId])
  @@map("user_branches")
}

// Allowed sign-in days and times in the gym timezone (D-017). No rows: any time.
model UserAccessWindow {
  id        String @id @default(uuid()) @db.Uuid
  userId    String @map("user_id") @db.Uuid
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  // ISO weekdays, 1 = Monday … 7 = Sunday.
  weekdays  Int[]
  startTime String @map("start_time")
  endTime   String @map("end_time")

  @@index([userId])
  @@map("user_access_windows")
}

// Every sign-in attempt (D-017). Insert-only.
model LoginEvent {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  email     String
  success   Boolean
  // Why a sign-in failed: WRONG_PASSWORD, UNKNOWN_USER, DISABLED, OUTSIDE_HOURS, RATE_LIMITED.
  reason    String?
  ip        String?
  userAgent String?  @map("user_agent")
  at        DateTime @default(now()) @db.Timestamptz(3)

  @@index([userId, at])
  @@map("login_history")
}

// ---------------------------------------------------------------------------
// Configuration (T-049): values admin changes on screen; the flows stay in code.
// ---------------------------------------------------------------------------

// One option of an option list (D-016). The list keys are code (packages/shared);
// options are never deleted, only made inactive, so old records keep theirs. One
// "Khác" per list (partial unique index in migration SQL), which needs a note.
model Option {
  id        String   @id @default(uuid()) @db.Uuid
  listKey   String   @map("list_key")
  labelVi   String   @map("label_vi")
  labelEn   String   @map("label_en")
  sortOrder Int      @map("sort_order")
  active    Boolean  @default(true)
  isOther   Boolean  @default(false) @map("is_other")
  // The number the owner gives an entry of a list (e.g. "Chi tiết nhu cầu", D-066); unique in its list when given.
  code      String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  paymentMethods       Payment[]                  @relation("PaymentMethod")
  burnShowReasons      Booking[]                  @relation("BookingAddedReason")
  cashMethods          CashTransaction[]          @relation("CashMethod")
  cashOpeningMethods   CashOpeningBalance[]       @relation("CashOpeningMethod")
  paymentDeleteReasons Payment[]                  @relation("PaymentDeleteReason")
  cashCategories       CashTransaction[]          @relation("CashCategory")
  cashDeleteReasons    CashTransaction[]          @relation("CashDeleteReason")
  trashEntries         TrashEntry[]
  approvalRejections   ApprovalRequest[]
  employeeDepartments  Employee[]                 @relation("EmployeeDepartment")
  employeeTitles       Employee[]                 @relation("EmployeeTitle")
  personChannels       Customer[]                 @relation("PersonChannel")
  personSources        Customer[]                 @relation("PersonSource")
  personNeedGroups     Customer[]                 @relation("PersonNeedGroup")
  personNeedDetails    Customer[]                 @relation("PersonNeedDetail")
  personPainStatuses   Customer[]                 @relation("PersonPainStatus")
  personAssessments    Customer[]                 @relation("PersonAssessmentType")
  personRefuseReasons  Customer[]                 @relation("PersonRefuseReason")
  personCustomerGroups Customer[]                 @relation("PersonCustomerGroup")
  auditFailReasons     ConsultingAuditCriterion[] @relation("AuditFailReason")
  leadStatusReasons    LeadStatusChange[]
  taskDepartments      Task[]
  inquiryChannels      LeadInquiry[]              @relation("InquiryChannel")
  inquirySources       LeadInquiry[]              @relation("InquirySource")
  inquiryNeedGroups    LeadInquiry[]              @relation("InquiryNeedGroup")
  personMerges         PersonMerge[]
  contractExceptions   Contract[]                 @relation("ContractExceptionReason")
  contractsDeletedFor  Contract[]                 @relation("ContractDeleteReason")
  freezeReasons        ContractFreeze[]           @relation("FreezeReason")
  freezeEndReasons     ContractFreeze[]           @relation("FreezeEndReason")

  @@unique([listKey, labelVi])
  @@unique([listKey, code])
  @@index([listKey, sortOrder])
  @@map("options")
}

// A system parameter (T-049). Keys and defaults are code (packages/shared); a missing
// row means the default.
model SystemParameter {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("system_parameters")
}

model AuthSession {
  id        String   @id @default(uuid()) @db.Uuid
  token     String   @unique
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([userId])
  @@map("auth_sessions")
}

model AuthAccount {
  id                    String    @id @default(uuid()) @db.Uuid
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id") @db.Uuid
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([userId])
  @@map("auth_accounts")
}

model AuthVerification {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([identifier])
  @@map("auth_verifications")
}

model AuthRateLimit {
  id          String @id @default(uuid()) @db.Uuid
  key         String @unique
  count       Int
  lastRequest BigInt @map("last_request")

  @@map("auth_rate_limits")
}

// ---------------------------------------------------------------------------
// Audit (T-022): written in the same transaction as the change it describes.
// ---------------------------------------------------------------------------

model AuditEvent {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  actor       User?    @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  entityType  String   @map("entity_type")
  entityId    String   @map("entity_id") @db.Uuid
  action      String
  // T-048: the record's values before and after the change; null for a create
  // (before) or a delete (after). Updates hold the changed fields only.
  before      Json?
  after       Json?
  // What else explains the change, e.g. a reason or the contract it belongs to.
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([entityType, entityId])
  @@index([actorUserId])
  @@index([createdAt])
  @@map("audit_events")
}

// The trash (D-035, T-047): one entry per deleted record, kept forever with the
// record as it was. The application has no path to change or remove an entry.
model TrashEntry {
  id          String   @id @default(uuid()) @db.Uuid
  entityType  String   @map("entity_type")
  entityId    String   @map("entity_id") @db.Uuid
  branchId    String   @map("branch_id") @db.Uuid
  branch      Branch   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  // A short name and amount for lists; the full record is in the snapshot.
  title       String
  amount      Decimal? @db.Decimal(14, 0)
  snapshot    Json
  reasonId    String   @map("reason_option_id") @db.Uuid
  reason      Option   @relation(fields: [reasonId], references: [id], onDelete: Restrict)
  reasonNote  String?  @map("reason_note")
  deletedById String   @map("deleted_by") @db.Uuid
  deletedBy   User     @relation(fields: [deletedById], references: [id], onDelete: Restrict)
  deletedAt   DateTime @map("deleted_at") @db.Timestamptz(3)

  @@unique([entityType, entityId])
  @@index([deletedAt])
  @@map("trash_entries")
}

// ---------------------------------------------------------------------------
// Approvals (D-018): the matrix and the requests. Action keys are code
// (packages/shared/approvals); which need approval and who approves is configuration.
// ---------------------------------------------------------------------------

model ApprovalRule {
  // An id of its own so the audit log can key the rule's history (T-048).
  id           String             @id @default(uuid()) @db.Uuid
  actionType   String             @unique @map("action_type")
  required     Boolean
  overdueHours Int                @map("overdue_hours")
  updatedAt    DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  approvers    ApprovalRuleRole[]

  @@map("approval_rules")
}

model ApprovalRuleRole {
  actionType String       @map("action_type")
  rule       ApprovalRule @relation(fields: [actionType], references: [actionType], onDelete: Cascade)
  roleId     String       @map("role_id") @db.Uuid
  role       Role         @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([actionType, roleId])
  @@map("approval_rule_roles")
}

// One request per submission. The decider is never the submitter, one PENDING request
// per record and action, and the decision facts are complete: CHECKs and a partial
// unique index in migration SQL.
model ApprovalRequest {
  id               String         @id @default(uuid()) @db.Uuid
  actionType       String         @map("action_type")
  entityType       String         @map("entity_type")
  entityId         String         @map("entity_id") @db.Uuid
  branchId         String         @map("branch_id") @db.Uuid
  branch           Branch         @relation(fields: [branchId], references: [id], onDelete: Restrict)
  title            String
  amount           Decimal?       @db.Decimal(14, 0)
  // What approval applies, e.g. a customer's new phone, or a deletion's reason.
  payload          Json           @default("{}")
  status           ApprovalStatus @default(PENDING)
  submittedById    String         @map("submitted_by") @db.Uuid
  submittedBy      User           @relation("ApprovalSubmittedBy", fields: [submittedById], references: [id], onDelete: Restrict)
  submittedAt      DateTime       @default(now()) @map("submitted_at") @db.Timestamptz(3)
  decidedById      String?        @map("decided_by") @db.Uuid
  decidedBy        User?          @relation("ApprovalDecidedBy", fields: [decidedById], references: [id], onDelete: Restrict)
  decidedAt        DateTime?      @map("decided_at") @db.Timestamptz(3)
  rejectReasonId   String?        @map("reject_reason_option_id") @db.Uuid
  rejectReason     Option?        @relation(fields: [rejectReasonId], references: [id], onDelete: Restrict)
  rejectReasonNote String?        @map("reject_reason_note")

  // When the overdue reminder went out (A-037), so it goes out once.
  overdueNotifiedAt DateTime? @map("overdue_notified_at") @db.Timestamptz(3)

  @@index([status, actionType])
  @@index([entityId])
  @@map("approval_requests")
}

// ---------------------------------------------------------------------------
// Customers
// ---------------------------------------------------------------------------

// A person: a lead until Show, then a customer, in this one record (D-019, T-061). The
// table keeps its name; checks in the migration tie the codes and phone to the stage.
model Customer {
  id                    String               @id @default(uuid()) @db.Uuid
  branchId              String               @map("branch_id") @db.Uuid
  branch                Branch               @relation(fields: [branchId], references: [id], onDelete: Restrict)
  stage                 PersonStage          @default(CUSTOMER)
  // From lead_code_seq (D-038); only people who came in as leads have one. Never updated.
  leadCode              String?              @unique @map("lead_code")
  // From customer_code_seq (T-019), given at Show. Never updated.
  customerCode          String?              @unique @map("customer_code")
  // The user code on the fingerprint machine (M5.3b, D-072); never a fingerprint.
  machineUserCode       String?              @unique @map("machine_user_code")
  // The lead journey (D-020); null for customers who never were leads.
  leadStatus            LeadStatus?          @map("lead_status")
  fullName              String               @map("full_name")
  // fullName lowercased without Vietnamese diacritics, for accent-insensitive search.
  searchName            String               @map("search_name")
  // Required of customers; a lead may not have one yet.
  phone                 String?
  email                 String?
  dateOfBirth           DateTime?            @map("date_of_birth") @db.Date
  gender                Gender?
  // The lead profile (brief §4.1): choices from option lists, "Khác" with a note (D-016).
  channelId             String?              @map("channel_option_id") @db.Uuid
  channel               Option?              @relation("PersonChannel", fields: [channelId], references: [id], onDelete: Restrict)
  channelNote           String?              @map("channel_note")
  sourceId              String?              @map("source_option_id") @db.Uuid
  source                Option?              @relation("PersonSource", fields: [sourceId], references: [id], onDelete: Restrict)
  sourceNote            String?              @map("source_note")
  sourceType            SourceType?          @map("source_type")
  sourceDetail          String?              @map("source_detail")
  // A country of ISO 3166-1; the group below is derived from it (D-057). Empty for old data that says only
  // "foreign": those people need the country completed.
  countryCode           String?              @map("country_code") @db.Char(2)
  nationalityGroup      NationalityGroup?    @map("nationality_group")
  needGroupId           String?              @map("need_group_option_id") @db.Uuid
  needGroup             Option?              @relation("PersonNeedGroup", fields: [needGroupId], references: [id], onDelete: Restrict)
  needGroupNote         String?              @map("need_group_note")
  // D-066: the coded catalog "needDetails"; `needDetail` below is the note written with it.
  needDetailId          String?              @map("need_detail_option_id") @db.Uuid
  needDetailOption      Option?              @relation("PersonNeedDetail", fields: [needDetailId], references: [id], onDelete: Restrict)
  needDetail            String?              @map("need_detail")
  painStatusId          String?              @map("pain_status_option_id") @db.Uuid
  painStatus            Option?              @relation("PersonPainStatus", fields: [painStatusId], references: [id], onDelete: Restrict)
  painStatusNote        String?              @map("pain_status_note")
  assessmentTypeId      String?              @map("assessment_type_option_id") @db.Uuid
  assessmentType        Option?              @relation("PersonAssessmentType", fields: [assessmentTypeId], references: [id], onDelete: Restrict)
  assessmentTypeNote    String?              @map("assessment_type_note")
  // The person in charge (PIC), given round-robin or by a manager (BR-203).
  picUserId             String?              @map("pic_user_id") @db.Uuid
  pic                   User?                @relation("PersonPic", fields: [picUserId], references: [id], onDelete: Restrict)
  // When the lead entered its status (D-020); null for customers who never were leads.
  leadStatusChangedAt   DateTime?            @map("lead_status_changed_at") @db.Timestamptz(3)
  // Appointment booked: when they are expected.
  appointmentAt         DateTime?            @map("appointment_at") @db.Timestamptz(3)
  // No response, Refused, No show: the gym day to contact them again (BR-204).
  contactAgainOn        DateTime?            @map("contact_again_on") @db.Date
  // Refused: why, from "leadRefuseReasons" (BR-204).
  refuseReasonId        String?              @map("refuse_reason_option_id") @db.Uuid
  refuseReason          Option?              @relation("PersonRefuseReason", fields: [refuseReasonId], references: [id], onDelete: Restrict)
  refuseReasonNote      String?              @map("refuse_reason_note")
  // The checklist version the lead started with; later versions apply to new leads only (D-020).
  checklistId           String?              @map("checklist_id") @db.Uuid
  checklist             ConsultingChecklist? @relation(fields: [checklistId], references: [id], onDelete: Restrict)
  // Given at Show (D-019, D-042). The number and the health note are encrypted in the
  // application (platform/security/field-crypto.ts); the database never sees them in plain text.
  idDocumentType        IdDocumentType?      @map("id_document_type")
  idDocumentNumber      String?              @map("id_document_number")
  nationality           String?
  healthNote            String?              @map("health_note")
  // The customer agreed that the ID and health data are kept (D-042): when, and who recorded it.
  dataConsentAt         DateTime?            @map("data_consent_at") @db.Timestamptz(3)
  dataConsentById       String?              @map("data_consent_by") @db.Uuid
  dataConsentBy         User?                @relation("PersonDataConsent", fields: [dataConsentById], references: [id], onDelete: Restrict)
  // The profile of brief §4.2. The address and the emergency contact are hidden together (A-069).
  address               String?
  emergencyContactName  String?              @map("emergency_contact_name")
  emergencyContactPhone String?              @map("emergency_contact_phone")
  customerGroupId       String?              @map("customer_group_option_id") @db.Uuid
  customerGroup         Option?              @relation("PersonCustomerGroup", fields: [customerGroupId], references: [id], onDelete: Restrict)
  customerGroupNote     String?              @map("customer_group_note")
  status                CustomerStatus       @default(ACTIVE)
  notes                 String?
  // D-017 data scope "own" (A-029); null for customers created before it was recorded.
  createdById           String?              @map("created_by") @db.Uuid
  createdBy             User?                @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt             DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  contracts         Contract[]
  bookings          Booking[]
  leadStatusChanges LeadStatusChange[]
  leadAssignments   LeadAssignment[]
  leadSteps         LeadStep[]
  inquiries         LeadInquiry[]       @relation("InquiryPerson")
  companionOf       ContractCompanion[] @relation("CompanionOf")
  emails            EmailMessage[]      @relation("PersonEmails")
  leadNotes         LeadNote[]
  consultingAudits  ConsultingAudit[]

  // Set when this record was merged into another (A-064): it is hidden everywhere, its codes stay reserved.
  mergedIntoId     String?           @map("merged_into_id") @db.Uuid
  mergedInto       Customer?         @relation("CustomerMergedInto", fields: [mergedIntoId], references: [id], onDelete: Restrict)
  mergedFrom       Customer[]        @relation("CustomerMergedInto")
  mergedAt         DateTime?         @map("merged_at") @db.Timestamptz(3)
  mergesAsSurvivor PersonMerge[]     @relation("MergeSurvivor")
  mergeAsMerged    PersonMerge?      @relation("MergeMerged")
  classAttendances ClassAttendance[]

  @@index([phone])
  @@index([searchName])
  @@index([branchId])
  @@index([stage, leadStatus])
  @@index([picUserId])
  @@index([createdAt])
  @@map("customers")
}

// A note on a lead or, after Show, on the customer: append-only, never edited or deleted (A-074).
model LeadNote {
  id        String   @id @default(uuid()) @db.Uuid
  personId  String   @map("person_id") @db.Uuid
  person    Customer @relation(fields: [personId], references: [id], onDelete: Restrict)
  body      String
  createdBy String   @map("created_by") @db.Uuid
  author    User     @relation("LeadNoteAuthor", fields: [createdBy], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([personId, createdAt])
  @@map("lead_notes")
}

enum ConsultingAuditResult {
  PASS
  FAIL
}

// A manager's grade of a lead's consulting (A-086, A-087): append-only; the latest counts.
model ConsultingAudit {
  id        String                     @id @default(uuid()) @db.Uuid
  personId  String                     @map("person_id") @db.Uuid
  person    Customer                   @relation(fields: [personId], references: [id], onDelete: Restrict)
  result    ConsultingAuditResult
  comment   String?
  auditorId String                     @map("auditor_id") @db.Uuid
  auditor   User                       @relation("ConsultingAuditor", fields: [auditorId], references: [id], onDelete: Restrict)
  createdAt DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  // The criteria not met, from the list "auditFailReasons".
  criteria  ConsultingAuditCriterion[]

  @@index([personId, createdAt])
  @@map("consulting_audits")
}

model ConsultingAuditCriterion {
  auditId  String          @map("audit_id") @db.Uuid
  audit    ConsultingAudit @relation(fields: [auditId], references: [id], onDelete: Restrict)
  optionId String          @map("option_id") @db.Uuid
  option   Option          @relation("AuditFailReason", fields: [optionId], references: [id], onDelete: Restrict)

  @@id([auditId, optionId])
  @@map("consulting_audit_criteria")
}

// What the automatic consulting audit checks besides the steps' timing (A-083): a switch and a weight each.
model AuditCriterion {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  active    Boolean  @default(true)
  weight    Int      @default(1)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("audit_criteria")
}

// The consulting script library (brief §4.1, FR-LEAD-010): a situation and its answer in
// both languages. Never deleted, only made inactive (A-072).
model ConsultingScript {
  id          String   @id @default(uuid()) @db.Uuid
  situationVi String   @map("situation_vi")
  situationEn String   @map("situation_en")
  answerVi    String?  @map("answer_vi")
  answerEn    String?  @map("answer_en")
  active      Boolean  @default(true)
  sortOrder   Int      @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([sortOrder])
  @@map("consulting_scripts")
}

// Every status change of a lead, who and when (D-020): the timeline, conversion, and audit.
model LeadStatusChange {
  id            String      @id @default(uuid()) @db.Uuid
  customerId    String      @map("customer_id") @db.Uuid
  customer      Customer    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  // Null for the lead's creation.
  fromStatus    LeadStatus? @map("from_status")
  toStatus      LeadStatus  @map("to_status")
  // Null when the system did it (the round-robin assignment of a new lead).
  changedById   String?     @map("changed_by") @db.Uuid
  changedBy     User?       @relation(fields: [changedById], references: [id], onDelete: Restrict)
  changedAt     DateTime    @default(now()) @map("changed_at") @db.Timestamptz(3)
  appointmentAt DateTime?   @map("appointment_at") @db.Timestamptz(3)
  reasonId      String?     @map("reason_option_id") @db.Uuid
  reason        Option?     @relation(fields: [reasonId], references: [id], onDelete: Restrict)
  reasonNote    String?     @map("reason_note")
  note          String?

  @@index([customerId, changedAt])
  @@map("lead_status_changes")
}

// Every change of a lead's person in charge (BR-203).
model LeadAssignment {
  id            String             @id @default(uuid()) @db.Uuid
  customerId    String             @map("customer_id") @db.Uuid
  customer      Customer           @relation(fields: [customerId], references: [id], onDelete: Restrict)
  fromUserId    String?            @map("from_user_id") @db.Uuid
  fromUser      User?              @relation("LeadAssignmentFrom", fields: [fromUserId], references: [id], onDelete: Restrict)
  toUserId      String             @map("to_user_id") @db.Uuid
  toUser        User               @relation("LeadAssignmentTo", fields: [toUserId], references: [id], onDelete: Restrict)
  // Null for the round-robin and the automatic move; otherwise the manager who reassigned.
  assignedById  String?            @map("assigned_by") @db.Uuid
  assignedBy    User?              @relation("LeadAssignmentBy", fields: [assignedById], references: [id], onDelete: Restrict)
  assignedAt    DateTime           @default(now()) @map("assigned_at") @db.Timestamptz(3)
  // How it was given (D-050, D-052); RECLAIM is the system moving an untouched lead on.
  kind          LeadAssignmentKind @default(ROUND_ROBIN)
  // RECLAIM: the working minutes the lead waited before it moved (D-052).
  waitedMinutes Int?               @map("waited_minutes")

  @@index([customerId, assignedAt])
  @@index([kind, assignedAt])
  @@map("lead_assignments")
}

// The consulting checklist (D-020). Saving it makes a new version; versions and their
// steps are never changed, so a lead's steps can point at them.
model ConsultingChecklist {
  id          String                   @id @default(uuid()) @db.Uuid
  version     Int                      @unique
  // Who saved it; no foreign key, so clearing test accounts never takes the seeded version with them.
  createdById String?                  @map("created_by") @db.Uuid
  createdAt   DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  steps       ConsultingStepTemplate[]
  leads       Customer[]

  @@map("consulting_checklists")
}

model ConsultingStepTemplate {
  id             String              @id @default(uuid()) @db.Uuid
  checklistId    String              @map("checklist_id") @db.Uuid
  checklist      ConsultingChecklist @relation(fields: [checklistId], references: [id], onDelete: Restrict)
  sortOrder      Int                 @map("sort_order")
  key            String
  labelVi        String              @map("label_vi")
  labelEn        String              @map("label_en")
  trigger        StepTrigger
  triggerStatus  LeadStatus?         @map("trigger_status")
  triggerStepKey String?             @map("trigger_step_key")
  // Minutes after the trigger; negative: before the appointment.
  offsetMinutes  Int                 @map("offset_minutes")
  required       Boolean
  // What opens the step also does it (done with the first result, on time).
  autoComplete   Boolean             @default(false) @map("auto_complete")
  action         StepAction?
  // [{ labelVi, labelEn, effect }]; a step's result is its index here.
  results        Json
  leadSteps      LeadStep[]

  @@unique([checklistId, key])
  @@unique([checklistId, sortOrder])
  @@map("consulting_step_templates")
}

// A lead's step (FR-LEAD-004): waiting (no deadline), open (deadline), or done.
model LeadStep {
  id            String                 @id @default(uuid()) @db.Uuid
  customerId    String                 @map("customer_id") @db.Uuid
  customer      Customer               @relation(fields: [customerId], references: [id], onDelete: Restrict)
  templateId    String                 @map("template_id") @db.Uuid
  template      ConsultingStepTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)
  openedAt      DateTime?              @map("opened_at") @db.Timestamptz(3)
  dueAt         DateTime?              @map("due_at") @db.Timestamptz(3)
  // The person in charge was told it is due (once per deadline).
  dueNotifiedAt DateTime?              @map("due_notified_at") @db.Timestamptz(3)
  doneAt        DateTime?              @map("done_at") @db.Timestamptz(3)
  doneById      String?                @map("done_by") @db.Uuid
  doneBy        User?                  @relation(fields: [doneById], references: [id], onDelete: Restrict)
  resultIndex   Int?                   @map("result_index")
  note          String?
  timing        StepTiming?
  // D-054: when an open step passed its deadline and the grace period and became "Không thực hiện": locked, never ticked late.
  lockedAt      DateTime?              @map("locked_at") @db.Timestamptz(3)

  @@unique([customerId, templateId])
  @@index([dueAt])
  @@index([lockedAt])
  @@map("lead_steps")
}

enum LeadAssignmentKind {
  ROUND_ROBIN
  MANUAL
  RECLAIM
}

// Where each consultant stands in the weighted round-robin of a branch, as virtual time (D-050).
model LeadTurn {
  branchId  String   @map("branch_id") @db.Uuid
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  vtime     BigInt   @default(0)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@id([branchId, userId])
  @@map("lead_turns")
}

// Per branch, who got the last lead of the round-robin (BR-203); kept for the leads dealt before D-050.
model LeadRoundRobin {
  branchId   String   @id @map("branch_id") @db.Uuid
  branch     Branch   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  lastUserId String   @map("last_user_id") @db.Uuid
  lastUser   User     @relation(fields: [lastUserId], references: [id], onDelete: Restrict)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("lead_round_robin")
}

// ---------------------------------------------------------------------------
// Contracts. Derived values (completed/remaining sessions, paid, debt, EXPIRED)
// are computed, never stored (T-012, T-018, BR-013).
// ---------------------------------------------------------------------------

model Contract {
  id                  String         @id @default(uuid()) @db.Uuid
  branchId            String         @map("branch_id") @db.Uuid
  branch              Branch         @relation(fields: [branchId], references: [id], onDelete: Restrict)
  // Generated from the contract_code_seq sequence (T-019, A-003). Never updated.
  contractCode        String         @unique @map("contract_code")
  customerId          String         @map("customer_id") @db.Uuid
  customer            Customer       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  // The display name, generated from the service and the real session count (D-021); a brought-over contract keeps its own.
  packageName         String         @map("package_name")
  // The service sold and the tier its price came from (BR-301); empty only on contracts brought over from before the
  // tiers (is_imported).
  serviceId           String?        @map("service_id") @db.Uuid
  service             Service?       @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  priceTierId         String?        @map("price_tier_id") @db.Uuid
  priceTier           PriceTier?     @relation(fields: [priceTierId], references: [id], onDelete: Restrict)
  contractType        ContractType   @default(NEW) @map("contract_type")
  previousContractId  String?        @map("previous_contract_id") @db.Uuid
  previousContract    Contract?      @relation("ContractRenewals", fields: [previousContractId], references: [id], onDelete: Restrict)
  renewals            Contract[]     @relation("ContractRenewals")
  contractDate        DateTime       @map("contract_date") @db.Date
  // What was paid for the contract: the value after discounts and VAT (derived figures are never stored).
  contractValue       Decimal        @map("contract_value") @db.Decimal(14, 0)
  // Sessions bought; the bonus ones are kept apart (brief §5.1). Entitled = bought + bonus.
  totalSessions       Int            @map("total_sessions")
  bonusSessions       Int            @default(0) @map("bonus_sessions")
  bonusMonths         Int            @default(0) @map("bonus_months")
  bonusDays           Int            @default(0) @map("bonus_days")
  // The tier's validity when the contract was made.
  tierMonths          Int            @default(0) @map("tier_months")
  tierDays            Int            @default(0) @map("tier_days")
  // Opening balances (D-011): non-zero only for contracts imported at go-live.
  openingSessionsUsed Int            @default(0) @map("opening_sessions_used")
  openingPaidAmount   Decimal        @default(0) @map("opening_paid_amount") @db.Decimal(14, 0)
  startDate           DateTime       @map("start_date") @db.Date
  endDate             DateTime       @map("end_date") @db.Date
  activationDeadline  DateTime?      @map("activation_deadline") @db.Date
  // The price (BR-301, BR-302, A-113): the tier's, and the one approved; they differ on an exception price.
  tierUnitPrice       Decimal?       @map("tier_unit_price") @db.Decimal(14, 0)
  approvedUnitPrice   Decimal        @map("approved_unit_price") @db.Decimal(14, 0)
  isExceptionPrice    Boolean        @default(false) @map("is_exception_price")
  exceptionReasonId   String?        @map("exception_reason_option_id") @db.Uuid
  exceptionReason     Option?        @relation("ContractExceptionReason", fields: [exceptionReasonId], references: [id], onDelete: Restrict)
  exceptionNote       String?        @map("exception_note")
  promotionId         String?        @map("promotion_id") @db.Uuid
  promotion           Promotion?     @relation("ContractPromotion", fields: [promotionId], references: [id], onDelete: Restrict)
  voucherId           String?        @map("voucher_id") @db.Uuid
  voucher             Promotion?     @relation("ContractVoucher", fields: [voucherId], references: [id], onDelete: Restrict)
  promotionDiscount   Decimal        @default(0) @map("promotion_discount") @db.Decimal(14, 0)
  voucherDiscount     Decimal        @default(0) @map("voucher_discount") @db.Decimal(14, 0)
  vatPercent          Decimal        @default(0) @map("vat_percent") @db.Decimal(5, 2)
  vatAmount           Decimal        @default(0) @map("vat_amount") @db.Decimal(14, 0)
  signed              Boolean        @default(false)
  signedOn            DateTime?      @map("signed_on") @db.Date
  signedBy            String?        @map("signed_by")
  signatureNote       String?        @map("signature_note")
  paymentDueOn        DateTime?      @map("payment_due_on") @db.Date
  notes               String?
  // Brought over from before the tiers: no service, and its price is flagged as an exception.
  isImported          Boolean        @default(false) @map("is_imported")
  status              ContractStatus @default(DRAFT)
  // T-015: replaying a create with the same key returns this contract; the fingerprint is the request's content.
  idempotencyKey      String         @unique @map("idempotency_key")
  requestFingerprint  String?        @map("request_fingerprint")
  createdById         String         @map("created_by") @db.Uuid
  createdBy           User           @relation("ContractCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt           DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  // Approval (A-121): who turned a pending contract into an active one, and when.
  approvedById        String?        @map("approved_by") @db.Uuid
  approvedBy          User?          @relation("ContractApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)
  approvedAt          DateTime?      @map("approved_at") @db.Timestamptz(3)
  // Deletion (A-125, D-035): the row stays, marked, and is in the trash.
  deletedAt           DateTime?      @map("deleted_at") @db.Timestamptz(3)
  deletedById         String?        @map("deleted_by") @db.Uuid
  deletedBy           User?          @relation("ContractDeletedBy", fields: [deletedById], references: [id], onDelete: Restrict)
  deleteReasonId      String?        @map("delete_reason_option_id") @db.Uuid
  deleteReason        Option?        @relation("ContractDeleteReason", fields: [deleteReasonId], references: [id], onDelete: Restrict)
  deleteReasonNote    String?        @map("delete_reason_note")

  bookings         Booking[]
  freezes          ContractFreeze[]
  payments         Payment[]
  cashTransactions CashTransaction[]
  shares           ContractStaffShare[]
  companions       ContractCompanion[]
  classAttendances ClassAttendance[]

  @@index([customerId])
  @@index([branchId])
  @@index([serviceId])
  @@index([deletedAt])
  @@map("contracts")
}

enum ContractType {
  NEW
  RENEW
}

enum StaffRole {
  PT
  SALE
}

// A PT's or a salesperson's share of a contract, in percent; each role's shares total 100 (A-115).
model ContractStaffShare {
  contractId String    @map("contract_id") @db.Uuid
  contract   Contract  @relation(fields: [contractId], references: [id], onDelete: Cascade)
  role       StaffRole
  employeeId String    @map("employee_id") @db.Uuid
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  percent    Decimal   @db.Decimal(5, 2)

  @@id([contractId, role, employeeId])
  @@index([employeeId])
  @@map("contract_staff_shares")
}

// Other members of a group package (A-116).
model ContractCompanion {
  contractId String   @map("contract_id") @db.Uuid
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  customerId String   @map("customer_id") @db.Uuid
  customer   Customer @relation("CompanionOf", fields: [customerId], references: [id], onDelete: Restrict)

  @@id([contractId, customerId])
  @@index([customerId])
  @@map("contract_companions")
}

// ---------------------------------------------------------------------------
// Employees (M1 slice 6), bookings, and sessions (Phase 3).
// ---------------------------------------------------------------------------

model Employee {
  id              String         @id @default(uuid()) @db.Uuid
  branchId        String         @map("branch_id") @db.Uuid
  branch          Branch         @relation(fields: [branchId], references: [id], onDelete: Restrict)
  // Generated from the employee_code_seq sequence (T-019, D-038). Never updated.
  employeeCode    String         @unique @map("employee_code")
  machineUserCode String?        @unique @map("machine_user_code")
  fullName        String         @map("full_name")
  // fullName lowercased without Vietnamese diacritics, for accent-insensitive search.
  searchName      String         @map("search_name")
  birthDate       DateTime?      @map("birth_date") @db.Date
  gender          Gender?
  phone           String?
  email           String?
  // D-016: from the "departments" and "jobTitles" lists; "Khác" with a note.
  departmentId    String?        @map("department_option_id") @db.Uuid
  department      Option?        @relation("EmployeeDepartment", fields: [departmentId], references: [id], onDelete: Restrict)
  departmentNote  String?        @map("department_note")
  team            String?
  titleId         String?        @map("title_option_id") @db.Uuid
  title           Option?        @relation("EmployeeTitle", fields: [titleId], references: [id], onDelete: Restrict)
  titleNote       String?        @map("title_note")
  // D-046: the direct manager, told when this person's approval waits too long (D-048).
  managerId       String?        @map("manager_id") @db.Uuid
  manager         Employee?      @relation("EmployeeManager", fields: [managerId], references: [id], onDelete: Restrict)
  reports         Employee[]     @relation("EmployeeManager")
  status          EmployeeStatus @default(ACTIVE)
  // Teaches PT: on the PT calendar and bookable inside the working schedule (D-030).
  isTrainer       Boolean        @default(false) @map("is_trainer")
  // Brief §8.4: the employee's login; one employee per user.
  userId          String?        @unique @map("user_id") @db.Uuid
  user            User?          @relation(fields: [userId], references: [id], onDelete: Restrict)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  bookings             Booking[]
  contractShares       ContractStaffShare[]
  receiptsSold         Payment[]            @relation("PaymentSaleEmployee")
  shifts               EmployeeShift[]
  daysOff              EmployeeDayOff[]
  classesCoached       GymClass[]           @relation("ClassCoach")
  classSessionsCoached ClassSession[]       @relation("ClassSessionCoach")

  @@index([branchId])
  @@index([searchName])
  @@index([managerId])
  @@map("employees")
}

// The weekly working pattern (brief §8.4, D-030): ISO weekday 1 (Monday) to 7, and
// minutes after midnight, end exclusive (1440 is midnight). Checks in the migration.
model EmployeeShift {
  id          String   @id @default(uuid()) @db.Uuid
  employeeId  String   @map("employee_id") @db.Uuid
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  weekday     Int      @db.SmallInt
  startMinute Int      @map("start_minute") @db.SmallInt
  endMinute   Int      @map("end_minute") @db.SmallInt

  @@index([employeeId, weekday])
  @@map("employee_shifts")
}

// A day the employee does not work, whatever the weekly pattern says.
model EmployeeDayOff {
  id         String   @id @default(uuid()) @db.Uuid
  employeeId String   @map("employee_id") @db.Uuid
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date       DateTime @db.Date
  note       String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([employeeId, date])
  @@map("employee_days_off")
}

// A schedule record, not proof that a session happened. Overlap per trainer is
// refused by the booking_trainer_no_overlap exclusion constraint (T-014), and
// scheduled_end > scheduled_start by a CHECK (BR-011); both are in migration SQL.
model Booking {
  id                 String        @id @default(uuid()) @db.Uuid
  branchId           String        @map("branch_id") @db.Uuid
  branch             Branch        @relation(fields: [branchId], references: [id], onDelete: Restrict)
  customerId         String        @map("customer_id") @db.Uuid
  customer           Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  contractId         String        @map("contract_id") @db.Uuid
  contract           Contract      @relation(fields: [contractId], references: [id], onDelete: Restrict)
  // The employee who teaches the session (D-030).
  trainerId          String        @map("trainer_id") @db.Uuid
  trainer            Employee      @relation(fields: [trainerId], references: [id], onDelete: Restrict)
  scheduledStart     DateTime      @map("scheduled_start") @db.Timestamptz(3)
  scheduledEnd       DateTime      @map("scheduled_end") @db.Timestamptz(3)
  // A key of session_statuses (M5.1); the flags below are the rule applied when it was set (T-050).
  status             String        @default("BOOKED")
  statusRule         SessionStatus @relation(fields: [status], references: [code], onDelete: Restrict, onUpdate: Cascade)
  consumes           Boolean       @default(false)
  creditsPt          Boolean       @default(false) @map("credits_pt")
  holdsSlot          Boolean       @default(true) @map("holds_slot")
  statusSetAt        DateTime?     @map("status_set_at") @db.Timestamptz(3)
  statusSetById      String?       @map("status_set_by") @db.Uuid
  statusSetBy        User?         @relation("BookingStatusSetBy", fields: [statusSetById], references: [id], onDelete: Restrict)
  // Burn Show (M5.4, D-028): a trained session added by hand, with why (a CHECK in the migration).
  addedByHand        Boolean       @default(false) @map("added_by_hand")
  addedReasonId      String?       @map("added_reason_option_id") @db.Uuid
  addedReason        Option?       @relation("BookingAddedReason", fields: [addedReasonId], references: [id], onDelete: Restrict)
  addedReasonNote    String?       @map("added_reason_note")
  // Deleted from the check-in history after it was trained (D-026): when and by whom, for the PT's adjustment (D-027).
  historyDeletedAt   DateTime?     @map("history_deleted_at") @db.Timestamptz(3)
  historyDeletedById String?       @map("history_deleted_by") @db.Uuid
  historyDeletedBy   User?         @relation("BookingHistoryDeletedBy", fields: [historyDeletedById], references: [id], onDelete: Restrict)
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  session Session?

  // The pairing of a customer's scan and the PT's scan with this booking (M5.3b, D-070). Both set, in time: confirmed.
  customerScanId     String?       @map("customer_scan_id") @db.Uuid
  customerScan       CheckinScan?  @relation("BookingCustomerScan", fields: [customerScanId], references: [id], onDelete: Restrict)
  ptScanId           String?       @map("pt_scan_id") @db.Uuid
  ptScan             CheckinScan?  @relation("BookingPtScan", fields: [ptScanId], references: [id], onDelete: Restrict)
  // The PT said the customer trained but forgot to scan: a request to admin to confirm (D-071).
  scanRequestedAt    DateTime?     @map("scan_requested_at") @db.Timestamptz(3)
  scanRequestedById  String?       @map("scan_requested_by") @db.Uuid
  // The Studio Manager was told that this session still hangs after the escalation hours (D-071).
  hangingEscalatedAt DateTime?     @map("hanging_escalated_at") @db.Timestamptz(3)
  scans              CheckinScan[] @relation("ScanBooking")

  @@index([contractId, status])
  @@index([customerId])
  @@index([trainerId, scheduledStart])
  @@index([scheduledStart])
  @@index([branchId])
  @@map("bookings")
}

// Fulfillment facts of a booking, created at check-in. No status of its own (T-011):
// a contract's completed sessions are counted from booking status (T-012).
model Session {
  id                 String    @id @default(uuid()) @db.Uuid
  bookingId          String    @unique @map("booking_id") @db.Uuid
  booking            Booking   @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  checkedInAt        DateTime  @map("checked_in_at") @db.Timestamptz(3)
  // Null when a paired device scan confirmed the session (M5.3b).
  checkedInById      String?   @map("checked_in_by") @db.Uuid
  checkedInBy        User?     @relation("SessionCheckedInBy", fields: [checkedInById], references: [id], onDelete: Restrict)
  completedAt        DateTime? @map("completed_at") @db.Timestamptz(3)
  completedById      String?   @map("completed_by") @db.Uuid
  completedBy        User?     @relation("SessionCompletedBy", fields: [completedById], references: [id], onDelete: Restrict)
  // MANUAL (an admin confirmed it) or DEVICE (a paired scan, M5.3b); one event either way (D-069).
  confirmationMethod String    @default("MANUAL") @map("confirmation_method")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("sessions")
}

// ---------------------------------------------------------------------------
// Finance (Phase 4). Paid amount and debt are derived from payments that are not
// deleted (BR-013, D-034). Records are never edited; a mistake is deleted to the
// trash with a reason (D-035, T-047). Amount > 0 and the deletion facts are CHECKs in
// migration SQL.
// ---------------------------------------------------------------------------

model Payment {
  id               String         @id @default(uuid()) @db.Uuid
  branchId         String         @map("branch_id") @db.Uuid
  branch           Branch         @relation(fields: [branchId], references: [id], onDelete: Restrict)
  contractId       String         @map("contract_id") @db.Uuid
  contract         Contract       @relation(fields: [contractId], references: [id], onDelete: Restrict)
  amount           Decimal        @db.Decimal(14, 0)
  // D-016, D-034: from the "paymentMethods" option list.
  methodId         String         @map("method_option_id") @db.Uuid
  method           Option         @relation("PaymentMethod", fields: [methodId], references: [id], onDelete: Restrict)
  methodNote       String?        @map("method_note")
  // The gym day the money was received (T-039).
  paidOn           DateTime       @map("paid_on") @db.Date
  // D-018, D-034: counts toward the paid amount only when APPROVED.
  approvalStatus   ApprovalStatus @default(APPROVED) @map("approval_status")
  // T-015: replaying a create with the same key returns this payment.
  idempotencyKey   String         @unique @map("idempotency_key")
  // The receipt number (D-034): from receipt_seq, never reused; the collector is who recorded it.
  receiptNumber    String         @unique @map("receipt_number")
  // The salesperson the receipt is credited to (brief §8.1), an employee of the contract's branch.
  saleEmployeeId   String?        @map("sale_employee_id") @db.Uuid
  saleEmployee     Employee?      @relation("PaymentSaleEmployee", fields: [saleEmployeeId], references: [id], onDelete: Restrict)
  note             String?
  // The transfer proof picture (brief §8.1, M4.1b, A-144).
  proofFileId      String?        @map("proof_file_id") @db.Uuid
  proofFile        StoredFile?    @relation("PaymentProof", fields: [proofFileId], references: [id], onDelete: Restrict)
  createdById      String         @map("created_by") @db.Uuid
  createdBy        User           @relation("PaymentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  // Deleted to the trash (D-035, T-047): left out of lists, totals, and debt.
  deletedAt        DateTime?      @map("deleted_at") @db.Timestamptz(3)
  deletedById      String?        @map("deleted_by") @db.Uuid
  deletedBy        User?          @relation("PaymentDeletedBy", fields: [deletedById], references: [id], onDelete: Restrict)
  // From the "deleteReasons" option list (D-016, D-035).
  deleteReasonId   String?        @map("delete_reason_option_id") @db.Uuid
  deleteReason     Option?        @relation("PaymentDeleteReason", fields: [deleteReasonId], references: [id], onDelete: Restrict)
  deleteReasonNote String?        @map("delete_reason_note")

  @@index([contractId])
  @@index([paidOn])
  @@index([branchId])
  @@map("payments")
}

// The cash a branch held in one payment method when its books begin (M4.7, A-138): the cash book counts movements
// from `effective_on`, so the closing balance is opening + in - out. Set by an admin; every change is audited.
model CashOpeningBalance {
  id          String   @id @default(uuid()) @db.Uuid
  branchId    String   @map("branch_id") @db.Uuid
  branch      Branch   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  methodId    String   @map("method_option_id") @db.Uuid
  method      Option   @relation("CashOpeningMethod", fields: [methodId], references: [id], onDelete: Restrict)
  effectiveOn DateTime @map("effective_on") @db.Date
  amount      Decimal  @db.Decimal(14, 0)
  updatedById String   @map("updated_by") @db.Uuid
  updatedBy   User     @relation("CashOpeningUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([branchId, methodId])
  @@map("cash_opening_balances")
}

model CashTransaction {
  id               String              @id @default(uuid()) @db.Uuid
  branchId         String              @map("branch_id") @db.Uuid
  branch           Branch              @relation(fields: [branchId], references: [id], onDelete: Restrict)
  type             CashTransactionType
  // From "incomeCategories" or "expenseTypes", by type (D-016, D-034).
  categoryId       String              @map("category_option_id") @db.Uuid
  category         Option              @relation("CashCategory", fields: [categoryId], references: [id], onDelete: Restrict)
  categoryNote     String?             @map("category_note")
  amount           Decimal             @db.Decimal(14, 0)
  description      String?
  reference        String?
  // The gym day it happened (T-039).
  occurredOn       DateTime            @map("occurred_on") @db.Date
  // D-018, D-034: counts toward the totals only when APPROVED.
  approvalStatus   ApprovalStatus      @default(APPROVED) @map("approval_status")
  idempotencyKey   String              @unique @map("idempotency_key")
  // The voucher number (D-034): receipts without a contract share the receipt series, expenses have their own.
  number           String              @unique
  // An expense voucher's payee; the payer is who recorded it.
  payee            String?
  methodId         String              @map("method_option_id") @db.Uuid
  method           Option              @relation("CashMethod", fields: [methodId], references: [id], onDelete: Restrict)
  methodNote       String?             @map("method_note")
  // A refund on cancellation is an expense voucher linked to the contract (D-034).
  contractId       String?             @map("contract_id") @db.Uuid
  contract         Contract?           @relation(fields: [contractId], references: [id], onDelete: Restrict)
  createdById      String              @map("created_by") @db.Uuid
  createdBy        User                @relation("CashTransactionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  deletedAt        DateTime?           @map("deleted_at") @db.Timestamptz(3)
  deletedById      String?             @map("deleted_by") @db.Uuid
  deletedBy        User?               @relation("CashTransactionDeletedBy", fields: [deletedById], references: [id], onDelete: Restrict)
  deleteReasonId   String?             @map("delete_reason_option_id") @db.Uuid
  deleteReason     Option?             @relation("CashDeleteReason", fields: [deleteReasonId], references: [id], onDelete: Restrict)
  deleteReasonNote String?             @map("delete_reason_note")

  @@index([occurredOn])
  @@index([branchId])
  @@map("cash_transactions")
}

// ---------------------------------------------------------------------------
// Tasks and notifications (brief §8.2, FR-PLT-009; M1 slice 7)
// ---------------------------------------------------------------------------

// A task goes to one person or one department (D-037); a member of the department
// accepts it and becomes its assignee. Checks in the migration.
// Which reminder point went out for a task, so each goes out once (D-056); a new deadline clears them.
model TaskReminder {
  taskId        String   @map("task_id") @db.Uuid
  task          Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  minutesBefore Int      @map("minutes_before")
  sentAt        DateTime @map("sent_at") @db.Timestamptz(3)

  @@id([taskId, minutesBefore])
  @@map("task_reminders")
}

model Task {
  id                   String       @id @default(uuid()) @db.Uuid
  branchId             String       @map("branch_id") @db.Uuid
  branch               Branch       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  title                String
  description          String?
  assignerId           String       @map("assigner_id") @db.Uuid
  assigner             User         @relation("TaskAssigner", fields: [assignerId], references: [id], onDelete: Restrict)
  assigneeUserId       String?      @map("assignee_user_id") @db.Uuid
  assigneeUser         User?        @relation("TaskAssignee", fields: [assigneeUserId], references: [id], onDelete: Restrict)
  // From the "departments" list.
  assigneeDepartmentId String?      @map("assignee_department_option_id") @db.Uuid
  assigneeDepartment   Option?      @relation(fields: [assigneeDepartmentId], references: [id], onDelete: Restrict)
  dueAt                DateTime     @map("due_at") @db.Timestamptz(3)
  priority             TaskPriority @default(NORMAL)
  status               TaskStatus   @default(NEW)
  // The record the task is about: "lead", "customer", or "contract" (more with later modules).
  entityType           String?      @map("entity_type")
  entityId             String?      @map("entity_id") @db.Uuid
  // Set when the system made the task: "studio" for Báo Studio (brief §4.1), which updates its own.
  source               String?
  acceptedAt           DateTime?    @map("accepted_at") @db.Timestamptz(3)
  startedAt            DateTime?    @map("started_at") @db.Timestamptz(3)
  doneAt               DateTime?    @map("done_at") @db.Timestamptz(3)
  cancelledAt          DateTime?    @map("cancelled_at") @db.Timestamptz(3)
  // Its own reminder points, minutes before the deadline; none means the shared points (D-056).
  reminderMinutes      Int[]        @default([]) @map("reminder_minutes")
  // When the overdue notice went out, so it goes once (worker, T-059); the points before the deadline are `reminders`.
  overdueNotifiedAt    DateTime?    @map("overdue_notified_at") @db.Timestamptz(3)
  createdAt            DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  comments    TaskComment[]
  reminders   TaskReminder[]
  // The email whose final failure this task is about.
  failedEmail EmailMessage?  @relation("EmailFailureTask")

  @@index([assigneeUserId, status])
  @@index([assigneeDepartmentId, status])
  @@index([assignerId, status])
  @@index([branchId])
  @@index([status, dueAt])
  @@map("tasks")
}

// Comments are never edited or deleted; they are the task's conversation.
model TaskComment {
  id        String   @id @default(uuid()) @db.Uuid
  taskId    String   @map("task_id") @db.Uuid
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Restrict)
  authorId  String   @map("author_id") @db.Uuid
  author    User     @relation(fields: [authorId], references: [id], onDelete: Restrict)
  body      String
  // Users named in the comment; each was notified.
  mentions  String[] @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([taskId, createdAt])
  @@map("task_comments")
}

// One user's in-app notification. The kind and params are turned into text by the
// web app in the user's language.
model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String
  params    Json      @default("{}")
  link      String?
  readAt    DateTime? @map("read_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([userId, createdAt])
  @@map("notifications")
}

enum EmailStatus {
  QUEUED
  SENT
  FAILED
}

// The email outbox (D-036, D-059): written in the transaction of what caused the email, so a rolled-back change
// sends nothing; the worker sends it through the provider. The rows are also the customer's "Emails sent" tab.
model EmailMessage {
  id                String      @id @default(uuid()) @db.Uuid
  personId          String      @map("person_id") @db.Uuid
  person            Customer    @relation("PersonEmails", fields: [personId], references: [id], onDelete: Restrict)
  branchId          String      @map("branch_id") @db.Uuid
  branch            Branch      @relation(fields: [branchId], references: [id], onDelete: Restrict)
  // What caused it, e.g. "session.credited"; the template and the on/off switch hang on it (M6.2, M6.3).
  event             String
  // One email per cause: a retry of the same change finds its row and adds none (T-045).
  dedupeKey         String      @unique @map("dedupe_key")
  // The address as it was when the email was queued; a later change of the customer's email does not redirect it.
  toAddress         String?     @map("to_address")
  locale            String
  subject           String
  body              String
  status            EmailStatus @default(QUEUED)
  attempts          Int         @default(0)
  nextAttemptAt     DateTime    @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  // A code from EMAIL_FAILURES; the provider's own words stay in the log, never here (they can echo addresses).
  failure           String?
  providerMessageId String?     @map("provider_message_id")
  sentAt            DateTime?   @map("sent_at") @db.Timestamptz(3)
  // The user whose action caused it; the failure task is assigned by them.
  createdById       String?     @map("created_by_id") @db.Uuid
  createdBy         User?       @relation("EmailCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  // The reception task a final failure created, so there is one.
  failureTaskId     String?     @unique @map("failure_task_id") @db.Uuid
  failureTask       Task?       @relation("EmailFailureTask", fields: [failureTaskId], references: [id], onDelete: SetNull)
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([personId, createdAt])
  @@index([status, nextAttemptAt])
  @@map("email_messages")
}

// A person who wrote or came in again (BR-202, FR-LEAD-009): one row per intake on an
// existing record, so the timeline shows every inquiry while the person stays one record (D-019).
model LeadInquiry {
  id            String      @id @default(uuid()) @db.Uuid
  personId      String      @map("person_id") @db.Uuid
  person        Customer    @relation("InquiryPerson", fields: [personId], references: [id], onDelete: Restrict)
  branchId      String      @map("branch_id") @db.Uuid
  branch        Branch      @relation(fields: [branchId], references: [id], onDelete: Restrict)
  channelId     String      @map("channel_option_id") @db.Uuid
  channel       Option      @relation("InquiryChannel", fields: [channelId], references: [id], onDelete: Restrict)
  channelNote   String?     @map("channel_note")
  sourceId      String?     @map("source_option_id") @db.Uuid
  source        Option?     @relation("InquirySource", fields: [sourceId], references: [id], onDelete: Restrict)
  sourceNote    String?     @map("source_note")
  sourceType    SourceType? @map("source_type")
  sourceDetail  String?     @map("source_detail")
  needGroupId   String?     @map("need_group_option_id") @db.Uuid
  needGroup     Option?     @relation("InquiryNeedGroup", fields: [needGroupId], references: [id], onDelete: Restrict)
  needGroupNote String?     @map("need_group_note")
  needDetail    String?     @map("need_detail")
  note          String?
  createdById   String      @map("created_by") @db.Uuid
  createdBy     User        @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([personId, createdAt])
  @@map("lead_inquiries")
}

// Two records of one person merged into one (BR-202, D-019, A-064). The merged record stays
// as a row (its codes are never reused, D-038), marked with merged_into_id, and is in the trash.
model PersonMerge {
  id         String   @id @default(uuid()) @db.Uuid
  survivorId String   @map("survivor_id") @db.Uuid
  survivor   Customer @relation("MergeSurvivor", fields: [survivorId], references: [id], onDelete: Restrict)
  mergedId   String   @unique @map("merged_id") @db.Uuid
  merged     Customer @relation("MergeMerged", fields: [mergedId], references: [id], onDelete: Restrict)
  reasonId   String   @map("reason_option_id") @db.Uuid
  reason     Option   @relation(fields: [reasonId], references: [id], onDelete: Restrict)
  reasonNote String?  @map("reason_note")
  mergedById String   @map("merged_by") @db.Uuid
  mergedBy   User     @relation(fields: [mergedById], references: [id], onDelete: Restrict)
  // The merged record's fields before the merge, without encrypted values (A-066).
  before     Json
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([survivorId])
  @@map("person_merges")
}

// ---------------------------------------------------------------------------
// Services and price tiers (M4.1, D-021, brief §5.1)
// ---------------------------------------------------------------------------

enum ServiceKind {
  PT
  CLASS
  MEMBER
}

// What is sold. Services are never deleted, only made inactive: contracts keep pointing at them.
model Service {
  id             String      @id @default(uuid()) @db.Uuid
  name           String      @unique
  kind           ServiceKind
  // The window of the day it may be used, "HH:mm"; both or neither.
  allowedFrom    String?     @map("allowed_from")
  allowedTo      String?     @map("allowed_to")
  // A percent of the session's value credited to the PT (brief §5.1).
  commissionRate Decimal     @default(0) @map("commission_rate") @db.Decimal(5, 2)
  isGroup        Boolean     @default(false) @map("is_group")
  maxMembers     Int?        @map("max_members")
  maxPerWeek     Int?        @map("max_per_week")
  maxPerDay      Int?        @map("max_per_day")
  // Validity as a calendar day; outside it the service is not on sale.
  activeFrom     DateTime?   @map("active_from") @db.Date
  activeTo       DateTime?   @map("active_to") @db.Date
  active         Boolean     @default(true)
  notes          String?
  // The picture shown with the service (M4.1b, A-143).
  imageFileId    String?     @map("image_file_id") @db.Uuid
  imageFile      StoredFile? @relation("ServiceImage", fields: [imageFileId], references: [id], onDelete: Restrict)
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  branches      ServiceBranch[]
  versions      PriceTierVersion[]
  quickPackages QuickPackage[]
  promotions    PromotionService[]
  contracts     Contract[]

  @@map("services")
}

model ServiceBranch {
  serviceId String  @map("service_id") @db.Uuid
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  branchId  String  @map("branch_id") @db.Uuid
  branch    Branch  @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@id([serviceId, branchId])
  @@index([branchId])
  @@map("service_branches")
}

// One saved set of tiers of a service, in force from a calendar day until the next version starts (BR-301).
// A version is never edited: a change is a new version, and contracts keep the one they were signed at.
model PriceTierVersion {
  id            String   @id @default(uuid()) @db.Uuid
  serviceId     String   @map("service_id") @db.Uuid
  service       Service  @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  version       Int
  effectiveFrom DateTime @map("effective_from") @db.Date
  createdById   String?  @map("created_by_id") @db.Uuid
  createdBy     User?    @relation("PriceTierVersionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tiers PriceTier[]

  @@unique([serviceId, version])
  @@unique([serviceId, effectiveFrom])
  @@map("price_tier_versions")
}

model PriceTier {
  id             String           @id @default(uuid()) @db.Uuid
  versionId      String           @map("version_id") @db.Uuid
  version        PriceTierVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)
  minSessions    Int              @map("min_sessions")
  // null: no upper limit.
  maxSessions    Int?             @map("max_sessions")
  unitPrice      Decimal          @map("unit_price") @db.Decimal(14, 0)
  validityMonths Int              @map("validity_months")
  validityDays   Int              @map("validity_days")

  contracts Contract[]

  @@index([versionId, minSessions])
  @@map("price_tiers")
}

// A quick-pick count: a button that only fills in the number of sessions (FR-SVC-003).
model QuickPackage {
  id        String  @id @default(uuid()) @db.Uuid
  serviceId String  @map("service_id") @db.Uuid
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  sessions  Int

  @@unique([serviceId, sessions])
  @@map("quick_packages")
}

// ---------------------------------------------------------------------------
// Promotions and vouchers (M4.2, D-021, BR-303, A-110)
// ---------------------------------------------------------------------------

enum PromotionKind {
  PROMOTION
  VOUCHER
}

enum DiscountType {
  PERCENT
  AMOUNT
}

// A percent or an amount off the tier price, with dates; not an exception price. A promotion is picked from the
// list on offer; a voucher is found by its code. Never deleted, only made inactive.
model Promotion {
  id           String        @id @default(uuid()) @db.Uuid
  kind         PromotionKind
  name         String
  // Vouchers only; upper case, unique.
  code         String?       @unique
  discountType DiscountType  @map("discount_type")
  // A percent (0 to 100, two decimals) or whole đồng.
  value        Decimal       @db.Decimal(14, 2)
  validFrom    DateTime?     @map("valid_from") @db.Date
  validTo      DateTime?     @map("valid_to") @db.Date
  active       Boolean       @default(true)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  // None: every service.
  services PromotionService[]

  asPromotion Contract[] @relation("ContractPromotion")
  asVoucher   Contract[] @relation("ContractVoucher")

  @@index([kind, active])
  @@map("promotions")
}

model PromotionService {
  promotionId String    @map("promotion_id") @db.Uuid
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  serviceId   String    @map("service_id") @db.Uuid
  service     Service   @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@id([promotionId, serviceId])
  @@index([serviceId])
  @@map("promotion_services")
}

// One deactivation of a contract and how it ended (D-023, brief §5.5). Each freeze is its own record and extends the
// end date at most once, when it ends.
model ContractFreeze {
  id              String    @id @default(uuid()) @db.Uuid
  contractId      String    @map("contract_id") @db.Uuid
  contract        Contract  @relation(fields: [contractId], references: [id], onDelete: Cascade)
  frozenOn        DateTime  @map("frozen_on") @db.Date
  frozenAt        DateTime  @default(now()) @map("frozen_at") @db.Timestamptz(3)
  frozenById      String    @map("frozen_by") @db.Uuid
  frozenBy        User      @relation("FreezeStartedBy", fields: [frozenById], references: [id], onDelete: Restrict)
  reasonId        String    @map("reason_option_id") @db.Uuid
  reason          Option    @relation("FreezeReason", fields: [reasonId], references: [id], onDelete: Restrict)
  reasonNote      String?   @map("reason_note")
  // How it ended: null while it lasts.
  endedAt         DateTime? @map("ended_at") @db.Timestamptz(3)
  endedOn         DateTime? @map("ended_on") @db.Date
  endedById       String?   @map("ended_by") @db.Uuid
  endedBy         User?     @relation("FreezeEndedBy", fields: [endedById], references: [id], onDelete: Restrict)
  endReasonId     String?   @map("end_reason_option_id") @db.Uuid
  endReason       Option?   @relation("FreezeEndReason", fields: [endReasonId], references: [id], onDelete: Restrict)
  endReasonNote   String?   @map("end_reason_note")
  frozenDays      Int?      @map("frozen_days")
  addedDays       Int?      @map("added_days")
  previousEndDate DateTime? @map("previous_end_date") @db.Date
  newEndDate      DateTime? @map("new_end_date") @db.Date
  // When the manager was reminded that it lasted long (brief §5.5).
  remindedAt      DateTime? @map("reminded_at") @db.Timestamptz(3)

  @@index([contractId])
  @@map("contract_freezes")
}

// A private file kept in object storage (T-052, M4.1b, A-143): the row says what it is for and who may fetch it; the
// bytes are never served without a signed, expiring link. A file belongs to the record it is attached to.
model StoredFile {
  id           String   @id @default(uuid()) @db.Uuid
  purpose      String
  contentType  String   @map("content_type")
  size         Int
  sha256       String
  // Where the bytes are in the storage (a path or object key); never shown to a client.
  storageKey   String   @unique @map("storage_key")
  uploadedById String   @map("uploaded_by") @db.Uuid
  uploadedBy   User     @relation("FileUploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  serviceImages Service[] @relation("ServiceImage")
  paymentProofs Payment[] @relation("PaymentProof")

  @@map("files")
}

// The statuses a session can have and their rules (brief §6.2, D-025, M5.1); admin edits the flags, labels and color.
model SessionStatus {
  code       String   @id
  // For the audit trail, whose records point at a UUID.
  id         String   @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  labelVi    String   @map("label_vi")
  labelEn    String   @map("label_en")
  consumes   Boolean
  creditsPt  Boolean  @map("credits_pt")
  holdsSlot  Boolean  @map("holds_slot")
  locksOnSet Boolean  @map("locks_on_set")
  color      String
  sortOrder  Int      @map("sort_order")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  bookings Booking[]

  @@map("session_statuses")
}

// ---------------------------------------------------------------------------
// Fingerprint-ready check-in (M5.3b, D-069 to D-072). The CRM stores only the machine's user code, never a
// fingerprint or face image. A machine belongs to one branch and has its own secret key (only its hash is kept).
// ---------------------------------------------------------------------------

model CheckinDevice {
  id                 String    @id @default(uuid()) @db.Uuid
  branchId           String    @map("branch_id") @db.Uuid
  branch             Branch    @relation(fields: [branchId], references: [id], onDelete: Restrict)
  name               String
  keyHash            String    @unique @map("key_hash")
  active             Boolean   @default(true)
  lastSeenAt         DateTime? @map("last_seen_at") @db.Timestamptz(3)
  // Machine clock minus server clock at its last report; a large value raises a warning (D-072).
  clockOffsetSeconds Int?      @map("clock_offset_seconds")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  scans CheckinScan[]

  @@map("checkin_devices")
}

// Every scan received, kept raw for reconciliation (D-072). Result: WAITING (attached, the other side missing),
// PAIRED (confirmed the session), ERROR (see errorCode), REPEAT (counted once).
model CheckinScan {
  id              String        @id @default(uuid()) @db.Uuid
  deviceId        String        @map("device_id") @db.Uuid
  device          CheckinDevice @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  branchId        String        @map("branch_id") @db.Uuid
  machineUserCode String        @map("machine_user_code")
  scannedAt       DateTime      @map("scanned_at") @db.Timestamptz(3)
  receivedAt      DateTime      @default(now()) @map("received_at") @db.Timestamptz(3)
  subjectType     String?       @map("subject_type")
  customerId      String?       @map("customer_id") @db.Uuid
  employeeId      String?       @map("employee_id") @db.Uuid
  result          String
  errorCode       String?       @map("error_code")
  bookingId       String?       @map("booking_id") @db.Uuid
  booking         Booking?      @relation("ScanBooking", fields: [bookingId], references: [id], onDelete: Restrict)

  asCustomerScan Booking[] @relation("BookingCustomerScan")
  asPtScan       Booking[] @relation("BookingPtScan")

  @@unique([deviceId, machineUserCode, scannedAt])
  @@index([result, scannedAt])
  @@map("checkin_scans")
}

// ---------------------------------------------------------------------------
// Class schedule (M5.5, brief §6.4, D-031). A class is a weekly slot; its sessions are generated ahead of time; the
// attendance of a customer who is present consumes one session of their group-class contract (T-050: the sessions
// used are derived from these rows). The CHECKs are in migration SQL.
// ---------------------------------------------------------------------------

model GymClass {
  id        String   @id @default(uuid()) @db.Uuid
  branchId  String   @map("branch_id") @db.Uuid
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  name      String
  coachId   String   @map("coach_id") @db.Uuid
  coach     Employee @relation("ClassCoach", fields: [coachId], references: [id], onDelete: Restrict)
  capacity  Int
  // ISO weekdays, 1 = Monday to 7 = Sunday; the time is "HH:mm" in the gym timezone.
  weekdays  Int[]
  startTime String   @map("start_time")
  endTime   String   @map("end_time")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions ClassSession[]

  @@index([branchId])
  @@map("classes")
}

model ClassSession {
  id        String   @id @default(uuid()) @db.Uuid
  classId   String   @map("class_id") @db.Uuid
  gymClass  GymClass @relation(fields: [classId], references: [id], onDelete: Restrict)
  branchId  String   @map("branch_id") @db.Uuid
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  coachId   String   @map("coach_id") @db.Uuid
  coach     Employee @relation("ClassSessionCoach", fields: [coachId], references: [id], onDelete: Restrict)
  capacity  Int
  startsAt  DateTime @map("starts_at") @db.Timestamptz(3)
  endsAt    DateTime @map("ends_at") @db.Timestamptz(3)
  // SCHEDULED or CANCELLED (the class was switched off before it took place).
  status    String   @default("SCHEDULED")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  attendances ClassAttendance[]

  @@unique([classId, startsAt])
  @@index([startsAt])
  @@index([branchId, startsAt])
  @@index([coachId])
  @@map("class_sessions")
}

model ClassAttendance {
  id             String       @id @default(uuid()) @db.Uuid
  classSessionId String       @map("class_session_id") @db.Uuid
  classSession   ClassSession @relation(fields: [classSessionId], references: [id], onDelete: Restrict)
  customerId     String       @map("customer_id") @db.Uuid
  customer       Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  contractId     String       @map("contract_id") @db.Uuid
  contract       Contract     @relation(fields: [contractId], references: [id], onDelete: Restrict)
  // ENROLLED, PRESENT (consumes one session), or ABSENT.
  status         String       @default("ENROLLED")
  consumes       Boolean      @default(false)
  enrolledById   String       @map("enrolled_by") @db.Uuid
  enrolledBy     User         @relation("ClassEnrolledBy", fields: [enrolledById], references: [id], onDelete: Restrict)
  enrolledAt     DateTime     @default(now()) @map("enrolled_at") @db.Timestamptz(3)
  markedById     String?      @map("marked_by") @db.Uuid
  markedBy       User?        @relation("ClassMarkedBy", fields: [markedById], references: [id], onDelete: Restrict)
  markedAt       DateTime?    @map("marked_at") @db.Timestamptz(3)

  @@unique([classSessionId, customerId])
  @@index([contractId])
  @@index([customerId])
  @@map("class_attendances")
}
