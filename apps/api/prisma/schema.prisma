// Data model: docs/04_DATA_MODEL_ERD.md
// Tables and columns are snake_case so raw SQL (row locks, constraints) stays readable.
// All datetime columns are timestamptz (docs/04 "Time").

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  // ES modules with .js import paths, as Node.js and `tsc --module nodenext` expect.
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// D-017: a role's reach per resource: everything in the user's branches, or only the
// records the user is responsible for.
enum DataScope {
  ALL
  OWN
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum Locale {
  vi
  en
}

// Stored contract statuses; EXPIRED is derived from end_date (T-018).
enum ContractStatus {
  DRAFT
  ACTIVE
  CANCELLED
}

// D-019: one record per person; a lead becomes a customer at Show.
enum PersonStage {
  LEAD
  CUSTOMER
}

// D-020, brief §3.
enum LeadStatus {
  NEW
  CONSULTING
  CONSIDERING
  NO_RESPONSE
  BOOKED
  SHOWED
  NO_SHOW
  REFUSED
  CONTRACTED
}

// What opens a consulting step (D-020, packages/shared/src/leads/checklist.schema.ts).
enum StepTrigger {
  ASSIGNED
  STATUS
  APPOINTMENT
  AFTER_STEP
  RECARE
}

enum StepTiming {
  ON_TIME
  LATE
}

// What the system does when a consulting step is done (packages/shared/src/leads/checklist.schema.ts).
enum StepAction {
  STUDIO_TASK
}

// Citizen ID card or passport (brief §3 stage 3).
enum IdDocumentType {
  CCCD
  PASSPORT
}

enum SourceType {
  ORGANIC
  PAID
}

enum NationalityGroup {
  VIETNAM
  FOREIGN
}

// A-013
enum CustomerStatus {
  ACTIVE
  INACTIVE
}

// Working status (brief §8.4): an employee who left keeps their history but takes no
// new bookings.
enum EmployeeStatus {
  ACTIVE
  INACTIVE
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

// The booking owns the single lifecycle status (T-011).
enum BookingStatus {
  BOOKED
  CHECKED_IN
  COMPLETED
  CANCELLED
  NO_SHOW
}

// D-018: a request moves from PENDING to APPROVED or REJECTED by someone other than
// its submitter, or is CANCELLED when its record goes away. Records that can need
// approval use PENDING, APPROVED, and REJECTED, and count only when APPROVED.
enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

// Brief §8.2: the assignee accepts; DONE and CANCELLED are final.
enum TaskStatus {
  NEW
  ACCEPTED
  IN_PROGRESS
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
}

enum CashTransactionType {
  INCOME
  EXPENSE
}

// ---------------------------------------------------------------------------
// Identity. The User, AuthSession, AuthAccount, AuthVerification and
// AuthRateLimit shapes are dictated by Better Auth (T-028).
// ---------------------------------------------------------------------------

model User {
  id            String     @id @default(uuid()) @db.Uuid
  name          String
  email         String     @unique
  emailVerified Boolean    @default(false) @map("email_verified")
  image         String?
  roleId        String     @map("role_id") @db.Uuid
  role          Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  // D-014: every branch, including ones created later; otherwise the granted branches.
  allBranches   Boolean    @default(false) @map("all_branches")
  status        UserStatus @default(ACTIVE)
  locale        Locale     @default(vi)
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions           AuthSession[]
  accounts           AuthAccount[]
  auditEvents        AuditEvent[]
  contractsCreated   Contract[]
  // Brief §8.4: the employee this login belongs to, at most one.
  employee           Employee?
  sessionsCheckedIn  Session[]                @relation("SessionCheckedInBy")
  sessionsCompleted  Session[]                @relation("SessionCompletedBy")
  paymentsRecorded   Payment[]                @relation("PaymentCreatedBy")
  paymentsDeleted    Payment[]                @relation("PaymentDeletedBy")
  cashRecorded       CashTransaction[]        @relation("CashTransactionCreatedBy")
  cashDeleted        CashTransaction[]        @relation("CashTransactionDeletedBy")
  trashEntries       TrashEntry[]
  approvalsSubmitted ApprovalRequest[]        @relation("ApprovalSubmittedBy")
  approvalsDecided   ApprovalRequest[]        @relation("ApprovalDecidedBy")
  customersCreated   Customer[]
  leadsInCharge      Customer[]               @relation("PersonPic")
  dataConsentsTaken  Customer[]               @relation("PersonDataConsent")
  branches           UserBranch[]
  overrides          UserPermissionOverride[]
  accessWindows      UserAccessWindow[]
  loginEvents        LoginEvent[]
  tasksAssigned      Task[]                   @relation("TaskAssigner")
  tasksReceived      Task[]                   @relation("TaskAssignee")
  taskComments       TaskComment[]
  notifications      Notification[]
  leadStatusChanges  LeadStatusChange[]
  leadAssignedFrom   LeadAssignment[]         @relation("LeadAssignmentFrom")
  leadAssignedTo     LeadAssignment[]         @relation("LeadAssignmentTo")
  leadAssignedBy     LeadAssignment[]         @relation("LeadAssignmentBy")
  leadRoundRobins    LeadRoundRobin[]
  leadStepsDone      LeadStep[]

  @@index([roleId])
  @@map("users")
}

// ---------------------------------------------------------------------------
// Branches, roles, and permissions (D-014, D-017, T-046). Permission keys, data-scope
// resources, and maskable fields are a catalog in @flow/shared; rows here configure them.
// ---------------------------------------------------------------------------

model Branch {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  address   String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  users            UserBranch[]
  customers        Customer[]
  contracts        Contract[]
  employees        Employee[]
  bookings         Booking[]
  payments         Payment[]
  cashTransactions CashTransaction[]
  trashEntries     TrashEntry[]
  approvalRequests ApprovalRequest[]
  tasks            Task[]
  leadRoundRobin   LeadRoundRobin?

  @@map("branches")
}

model Role {
  id           String   @id @default(uuid()) @db.Uuid
  // Set on the default roles (09_RBAC.md) so code and tests can find them; null for
  // roles admin creates. Never shown to users.
  code         String?  @unique
  name         String   @unique
  description  String?
  clonedFromId String?  @map("cloned_from_id") @db.Uuid
  clonedFrom   Role?    @relation("RoleClones", fields: [clonedFromId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  clones        Role[]             @relation("RoleClones")
  users         User[]
  approvalRules ApprovalRuleRole[]
  permissions   RolePermission[]
  dataScopes    RoleDataScope[]
  fieldMasks    RoleFieldMask[]

  @@map("roles")
}

model RolePermission {
  roleId     String @map("role_id") @db.Uuid
  role       Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission String

  @@id([roleId, permission])
  @@map("role_permissions")
}

// A resource without a row is OWN: a new resource is closed until admin opens it.
model RoleDataScope {
  roleId   String    @map("role_id") @db.Uuid
  role     Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  resource String
  scope    DataScope

  @@id([roleId, resource])
  @@map("role_data_scopes")
}

model RoleFieldMask {
  roleId String @map("role_id") @db.Uuid
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  field  String

  @@id([roleId, field])
  @@map("role_field_masks")
}

// A user inherits the role and can have single permissions switched on or off.
model UserPermissionOverride {
  userId     String  @map("user_id") @db.Uuid
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission String
  granted    Boolean

  @@id([userId, permission])
  @@map("user_permission_overrides")
}

model UserBranch {
  userId   String @map("user_id") @db.Uuid
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branchId String @map("branch_id") @db.Uuid
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@id([userId, branchId])
  @@map("user_branches")
}

// Allowed sign-in days and times in the gym timezone (D-017). No rows: any time.
model UserAccessWindow {
  id        String @id @default(uuid()) @db.Uuid
  userId    String @map("user_id") @db.Uuid
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  // ISO weekdays, 1 = Monday … 7 = Sunday.
  weekdays  Int[]
  startTime String @map("start_time")
  endTime   String @map("end_time")

  @@index([userId])
  @@map("user_access_windows")
}

// Every sign-in attempt (D-017). Insert-only.
model LoginEvent {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  email     String
  success   Boolean
  // Why a sign-in failed: WRONG_PASSWORD, UNKNOWN_USER, DISABLED, OUTSIDE_HOURS, RATE_LIMITED.
  reason    String?
  ip        String?
  userAgent String?  @map("user_agent")
  at        DateTime @default(now()) @db.Timestamptz(3)

  @@index([userId, at])
  @@map("login_history")
}

// ---------------------------------------------------------------------------
// Configuration (T-049): values admin changes on screen; the flows stay in code.
// ---------------------------------------------------------------------------

// One option of an option list (D-016). The list keys are code (packages/shared);
// options are never deleted, only made inactive, so old records keep theirs. One
// "Khác" per list (partial unique index in migration SQL), which needs a note.
model Option {
  id        String   @id @default(uuid()) @db.Uuid
  listKey   String   @map("list_key")
  labelVi   String   @map("label_vi")
  labelEn   String   @map("label_en")
  sortOrder Int      @map("sort_order")
  active    Boolean  @default(true)
  isOther   Boolean  @default(false) @map("is_other")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  paymentMethods       Payment[]          @relation("PaymentMethod")
  paymentDeleteReasons Payment[]          @relation("PaymentDeleteReason")
  cashCategories       CashTransaction[]  @relation("CashCategory")
  cashDeleteReasons    CashTransaction[]  @relation("CashDeleteReason")
  trashEntries         TrashEntry[]
  approvalRejections   ApprovalRequest[]
  employeeDepartments  Employee[]         @relation("EmployeeDepartment")
  employeeTitles       Employee[]         @relation("EmployeeTitle")
  personChannels       Customer[]         @relation("PersonChannel")
  personSources        Customer[]         @relation("PersonSource")
  personNeedGroups     Customer[]         @relation("PersonNeedGroup")
  personPainStatuses   Customer[]         @relation("PersonPainStatus")
  personAssessments    Customer[]         @relation("PersonAssessmentType")
  personRefuseReasons  Customer[]         @relation("PersonRefuseReason")
  leadStatusReasons    LeadStatusChange[]
  taskDepartments      Task[]

  @@unique([listKey, labelVi])
  @@index([listKey, sortOrder])
  @@map("options")
}

// A system parameter (T-049). Keys and defaults are code (packages/shared); a missing
// row means the default.
model SystemParameter {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("system_parameters")
}

model AuthSession {
  id        String   @id @default(uuid()) @db.Uuid
  token     String   @unique
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([userId])
  @@map("auth_sessions")
}

model AuthAccount {
  id                    String    @id @default(uuid()) @db.Uuid
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id") @db.Uuid
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([userId])
  @@map("auth_accounts")
}

model AuthVerification {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([identifier])
  @@map("auth_verifications")
}

model AuthRateLimit {
  id          String @id @default(uuid()) @db.Uuid
  key         String @unique
  count       Int
  lastRequest BigInt @map("last_request")

  @@map("auth_rate_limits")
}

// ---------------------------------------------------------------------------
// Audit (T-022): written in the same transaction as the change it describes.
// ---------------------------------------------------------------------------

model AuditEvent {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  actor       User?    @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  entityType  String   @map("entity_type")
  entityId    String   @map("entity_id") @db.Uuid
  action      String
  // T-048: the record's values before and after the change; null for a create
  // (before) or a delete (after). Updates hold the changed fields only.
  before      Json?
  after       Json?
  // What else explains the change, e.g. a reason or the contract it belongs to.
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([entityType, entityId])
  @@index([actorUserId])
  @@index([createdAt])
  @@map("audit_events")
}

// The trash (D-035, T-047): one entry per deleted record, kept forever with the
// record as it was. The application has no path to change or remove an entry.
model TrashEntry {
  id          String   @id @default(uuid()) @db.Uuid
  entityType  String   @map("entity_type")
  entityId    String   @map("entity_id") @db.Uuid
  branchId    String   @map("branch_id") @db.Uuid
  branch      Branch   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  // A short name and amount for lists; the full record is in the snapshot.
  title       String
  amount      Decimal? @db.Decimal(14, 0)
  snapshot    Json
  reasonId    String   @map("reason_option_id") @db.Uuid
  reason      Option   @relation(fields: [reasonId], references: [id], onDelete: Restrict)
  reasonNote  String?  @map("reason_note")
  deletedById String   @map("deleted_by") @db.Uuid
  deletedBy   User     @relation(fields: [deletedById], references: [id], onDelete: Restrict)
  deletedAt   DateTime @map("deleted_at") @db.Timestamptz(3)

  @@unique([entityType, entityId])
  @@index([deletedAt])
  @@map("trash_entries")
}

// ---------------------------------------------------------------------------
// Approvals (D-018): the matrix and the requests. Action keys are code
// (packages/shared/approvals); which need approval and who approves is configuration.
// ---------------------------------------------------------------------------

model ApprovalRule {
  // An id of its own so the audit log can key the rule's history (T-048).
  id           String             @id @default(uuid()) @db.Uuid
  actionType   String             @unique @map("action_type")
  required     Boolean
  overdueHours Int                @map("overdue_hours")
  updatedAt    DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  approvers    ApprovalRuleRole[]

  @@map("approval_rules")
}

model ApprovalRuleRole {
  actionType String       @map("action_type")
  rule       ApprovalRule @relation(fields: [actionType], references: [actionType], onDelete: Cascade)
  roleId     String       @map("role_id") @db.Uuid
  role       Role         @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([actionType, roleId])
  @@map("approval_rule_roles")
}

// One request per submission. The decider is never the submitter, one PENDING request
// per record and action, and the decision facts are complete: CHECKs and a partial
// unique index in migration SQL.
model ApprovalRequest {
  id               String         @id @default(uuid()) @db.Uuid
  actionType       String         @map("action_type")
  entityType       String         @map("entity_type")
  entityId         String         @map("entity_id") @db.Uuid
  branchId         String         @map("branch_id") @db.Uuid
  branch           Branch         @relation(fields: [branchId], references: [id], onDelete: Restrict)
  title            String
  amount           Decimal?       @db.Decimal(14, 0)
  // What approval applies, e.g. a customer's new phone, or a deletion's reason.
  payload          Json           @default("{}")
  status           ApprovalStatus @default(PENDING)
  submittedById    String         @map("submitted_by") @db.Uuid
  submittedBy      User           @relation("ApprovalSubmittedBy", fields: [submittedById], references: [id], onDelete: Restrict)
  submittedAt      DateTime       @default(now()) @map("submitted_at") @db.Timestamptz(3)
  decidedById      String?        @map("decided_by") @db.Uuid
  decidedBy        User?          @relation("ApprovalDecidedBy", fields: [decidedById], references: [id], onDelete: Restrict)
  decidedAt        DateTime?      @map("decided_at") @db.Timestamptz(3)
  rejectReasonId   String?        @map("reject_reason_option_id") @db.Uuid
  rejectReason     Option?        @relation(fields: [rejectReasonId], references: [id], onDelete: Restrict)
  rejectReasonNote String?        @map("reject_reason_note")

  // When the overdue reminder went out (A-037), so it goes out once.
  overdueNotifiedAt DateTime? @map("overdue_notified_at") @db.Timestamptz(3)

  @@index([status, actionType])
  @@index([entityId])
  @@map("approval_requests")
}

// ---------------------------------------------------------------------------
// Customers
// ---------------------------------------------------------------------------

// A person: a lead until Show, then a customer, in this one record (D-019, T-061). The
// table keeps its name; checks in the migration tie the codes and phone to the stage.
model Customer {
  id                  String               @id @default(uuid()) @db.Uuid
  branchId            String               @map("branch_id") @db.Uuid
  branch              Branch               @relation(fields: [branchId], references: [id], onDelete: Restrict)
  stage               PersonStage          @default(CUSTOMER)
  // From lead_code_seq (D-038); only people who came in as leads have one. Never updated.
  leadCode            String?              @unique @map("lead_code")
  // From customer_code_seq (T-019), given at Show. Never updated.
  customerCode        String?              @unique @map("customer_code")
  // The lead journey (D-020); null for customers who never were leads.
  leadStatus          LeadStatus?          @map("lead_status")
  fullName            String               @map("full_name")
  // fullName lowercased without Vietnamese diacritics, for accent-insensitive search.
  searchName          String               @map("search_name")
  // Required of customers; a lead may not have one yet.
  phone               String?
  email               String?
  dateOfBirth         DateTime?            @map("date_of_birth") @db.Date
  gender              Gender?
  // The lead profile (brief §4.1): choices from option lists, "Khác" with a note (D-016).
  channelId           String?              @map("channel_option_id") @db.Uuid
  channel             Option?              @relation("PersonChannel", fields: [channelId], references: [id], onDelete: Restrict)
  channelNote         String?              @map("channel_note")
  sourceId            String?              @map("source_option_id") @db.Uuid
  source              Option?              @relation("PersonSource", fields: [sourceId], references: [id], onDelete: Restrict)
  sourceNote          String?              @map("source_note")
  sourceType          SourceType?          @map("source_type")
  sourceDetail        String?              @map("source_detail")
  nationalityGroup    NationalityGroup?    @map("nationality_group")
  needGroupId         String?              @map("need_group_option_id") @db.Uuid
  needGroup           Option?              @relation("PersonNeedGroup", fields: [needGroupId], references: [id], onDelete: Restrict)
  needGroupNote       String?              @map("need_group_note")
  needDetail          String?              @map("need_detail")
  painStatusId        String?              @map("pain_status_option_id") @db.Uuid
  painStatus          Option?              @relation("PersonPainStatus", fields: [painStatusId], references: [id], onDelete: Restrict)
  painStatusNote      String?              @map("pain_status_note")
  assessmentTypeId    String?              @map("assessment_type_option_id") @db.Uuid
  assessmentType      Option?              @relation("PersonAssessmentType", fields: [assessmentTypeId], references: [id], onDelete: Restrict)
  assessmentTypeNote  String?              @map("assessment_type_note")
  // The person in charge (PIC), given round-robin or by a manager (BR-203).
  picUserId           String?              @map("pic_user_id") @db.Uuid
  pic                 User?                @relation("PersonPic", fields: [picUserId], references: [id], onDelete: Restrict)
  // When the lead entered its status (D-020); null for customers who never were leads.
  leadStatusChangedAt DateTime?            @map("lead_status_changed_at") @db.Timestamptz(3)
  // Appointment booked: when they are expected.
  appointmentAt       DateTime?            @map("appointment_at") @db.Timestamptz(3)
  // No response, Refused, No show: the gym day to contact them again (BR-204).
  contactAgainOn      DateTime?            @map("contact_again_on") @db.Date
  // Refused: why, from "leadRefuseReasons" (BR-204).
  refuseReasonId      String?              @map("refuse_reason_option_id") @db.Uuid
  refuseReason        Option?              @relation("PersonRefuseReason", fields: [refuseReasonId], references: [id], onDelete: Restrict)
  refuseReasonNote    String?              @map("refuse_reason_note")
  // The checklist version the lead started with; later versions apply to new leads only (D-020).
  checklistId         String?              @map("checklist_id") @db.Uuid
  checklist           ConsultingChecklist? @relation(fields: [checklistId], references: [id], onDelete: Restrict)
  // Given at Show (D-019, D-042). The number and the health note are encrypted in the
  // application (platform/security/field-crypto.ts); the database never sees them in plain text.
  idDocumentType      IdDocumentType?      @map("id_document_type")
  idDocumentNumber    String?              @map("id_document_number")
  nationality         String?
  healthNote          String?              @map("health_note")
  // The customer agreed that the ID and health data are kept (D-042): when, and who recorded it.
  dataConsentAt       DateTime?            @map("data_consent_at") @db.Timestamptz(3)
  dataConsentById     String?              @map("data_consent_by") @db.Uuid
  dataConsentBy       User?                @relation("PersonDataConsent", fields: [dataConsentById], references: [id], onDelete: Restrict)
  status              CustomerStatus       @default(ACTIVE)
  notes               String?
  // D-017 data scope "own" (A-029); null for customers created before it was recorded.
  createdById         String?              @map("created_by") @db.Uuid
  createdBy           User?                @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  contracts         Contract[]
  bookings          Booking[]
  leadStatusChanges LeadStatusChange[]
  leadAssignments   LeadAssignment[]
  leadSteps         LeadStep[]

  @@index([phone])
  @@index([searchName])
  @@index([branchId])
  @@index([stage, leadStatus])
  @@index([picUserId])
  @@map("customers")
}

// Every status change of a lead, who and when (D-020): the timeline, conversion, and audit.
model LeadStatusChange {
  id            String      @id @default(uuid()) @db.Uuid
  customerId    String      @map("customer_id") @db.Uuid
  customer      Customer    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  // Null for the lead's creation.
  fromStatus    LeadStatus? @map("from_status")
  toStatus      LeadStatus  @map("to_status")
  // Null when the system did it (the round-robin assignment of a new lead).
  changedById   String?     @map("changed_by") @db.Uuid
  changedBy     User?       @relation(fields: [changedById], references: [id], onDelete: Restrict)
  changedAt     DateTime    @default(now()) @map("changed_at") @db.Timestamptz(3)
  appointmentAt DateTime?   @map("appointment_at") @db.Timestamptz(3)
  reasonId      String?     @map("reason_option_id") @db.Uuid
  reason        Option?     @relation(fields: [reasonId], references: [id], onDelete: Restrict)
  reasonNote    String?     @map("reason_note")
  note          String?

  @@index([customerId, changedAt])
  @@map("lead_status_changes")
}

// Every change of a lead's person in charge (BR-203).
model LeadAssignment {
  id           String   @id @default(uuid()) @db.Uuid
  customerId   String   @map("customer_id") @db.Uuid
  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  fromUserId   String?  @map("from_user_id") @db.Uuid
  fromUser     User?    @relation("LeadAssignmentFrom", fields: [fromUserId], references: [id], onDelete: Restrict)
  toUserId     String   @map("to_user_id") @db.Uuid
  toUser       User     @relation("LeadAssignmentTo", fields: [toUserId], references: [id], onDelete: Restrict)
  // Null for the round-robin; otherwise the manager who reassigned.
  assignedById String?  @map("assigned_by") @db.Uuid
  assignedBy   User?    @relation("LeadAssignmentBy", fields: [assignedById], references: [id], onDelete: Restrict)
  assignedAt   DateTime @default(now()) @map("assigned_at") @db.Timestamptz(3)

  @@index([customerId, assignedAt])
  @@map("lead_assignments")
}

// The consulting checklist (D-020). Saving it makes a new version; versions and their
// steps are never changed, so a lead's steps can point at them.
model ConsultingChecklist {
  id          String                   @id @default(uuid()) @db.Uuid
  version     Int                      @unique
  // Who saved it; no foreign key, so clearing test accounts never takes the seeded version with them.
  createdById String?                  @map("created_by") @db.Uuid
  createdAt   DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  steps       ConsultingStepTemplate[]
  leads       Customer[]

  @@map("consulting_checklists")
}

model ConsultingStepTemplate {
  id             String              @id @default(uuid()) @db.Uuid
  checklistId    String              @map("checklist_id") @db.Uuid
  checklist      ConsultingChecklist @relation(fields: [checklistId], references: [id], onDelete: Restrict)
  sortOrder      Int                 @map("sort_order")
  key            String
  labelVi        String              @map("label_vi")
  labelEn        String              @map("label_en")
  trigger        StepTrigger
  triggerStatus  LeadStatus?         @map("trigger_status")
  triggerStepKey String?             @map("trigger_step_key")
  // Minutes after the trigger; negative: before the appointment.
  offsetMinutes  Int                 @map("offset_minutes")
  required       Boolean
  // What opens the step also does it (done with the first result, on time).
  autoComplete   Boolean             @default(false) @map("auto_complete")
  action         StepAction?
  // [{ labelVi, labelEn, effect }]; a step's result is its index here.
  results        Json
  leadSteps      LeadStep[]

  @@unique([checklistId, key])
  @@unique([checklistId, sortOrder])
  @@map("consulting_step_templates")
}

// A lead's step (FR-LEAD-004): waiting (no deadline), open (deadline), or done.
model LeadStep {
  id            String                 @id @default(uuid()) @db.Uuid
  customerId    String                 @map("customer_id") @db.Uuid
  customer      Customer               @relation(fields: [customerId], references: [id], onDelete: Restrict)
  templateId    String                 @map("template_id") @db.Uuid
  template      ConsultingStepTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)
  openedAt      DateTime?              @map("opened_at") @db.Timestamptz(3)
  dueAt         DateTime?              @map("due_at") @db.Timestamptz(3)
  // The person in charge was told it is due (once per deadline).
  dueNotifiedAt DateTime?              @map("due_notified_at") @db.Timestamptz(3)
  doneAt        DateTime?              @map("done_at") @db.Timestamptz(3)
  doneById      String?                @map("done_by") @db.Uuid
  doneBy        User?                  @relation(fields: [doneById], references: [id], onDelete: Restrict)
  resultIndex   Int?                   @map("result_index")
  note          String?
  timing        StepTiming?

  @@unique([customerId, templateId])
  @@index([dueAt])
  @@map("lead_steps")
}

// Per branch, who got the last lead of the round-robin (BR-203).
model LeadRoundRobin {
  branchId   String   @id @map("branch_id") @db.Uuid
  branch     Branch   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  lastUserId String   @map("last_user_id") @db.Uuid
  lastUser   User     @relation(fields: [lastUserId], references: [id], onDelete: Restrict)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("lead_round_robin")
}

// ---------------------------------------------------------------------------
// Contracts. Derived values (completed/remaining sessions, paid, debt, EXPIRED)
// are computed, never stored (T-012, T-018, BR-013).
// ---------------------------------------------------------------------------

model Contract {
  id                  String         @id @default(uuid()) @db.Uuid
  branchId            String         @map("branch_id") @db.Uuid
  branch              Branch         @relation(fields: [branchId], references: [id], onDelete: Restrict)
  // Generated from the contract_code_seq sequence (T-019, A-003). Never updated.
  contractCode        String         @unique @map("contract_code")
  customerId          String         @map("customer_id") @db.Uuid
  customer            Customer       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  packageName         String         @map("package_name")
  contractValue       Decimal        @map("contract_value") @db.Decimal(14, 0)
  totalSessions       Int            @map("total_sessions")
  // Opening balances (D-011): non-zero only for contracts imported at go-live.
  openingSessionsUsed Int            @default(0) @map("opening_sessions_used")
  openingPaidAmount   Decimal        @default(0) @map("opening_paid_amount") @db.Decimal(14, 0)
  startDate           DateTime       @map("start_date") @db.Date
  endDate             DateTime       @map("end_date") @db.Date
  status              ContractStatus @default(DRAFT)
  // T-015: replaying a create with the same key returns this contract.
  idempotencyKey      String         @unique @map("idempotency_key")
  createdById         String         @map("created_by") @db.Uuid
  createdBy           User           @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt           DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  bookings Booking[]
  payments Payment[]

  @@index([customerId])
  @@index([branchId])
  @@map("contracts")
}

// ---------------------------------------------------------------------------
// Employees (M1 slice 6), bookings, and sessions (Phase 3).
// ---------------------------------------------------------------------------

model Employee {
  id             String         @id @default(uuid()) @db.Uuid
  branchId       String         @map("branch_id") @db.Uuid
  branch         Branch         @relation(fields: [branchId], references: [id], onDelete: Restrict)
  // Generated from the employee_code_seq sequence (T-019, D-038). Never updated.
  employeeCode   String         @unique @map("employee_code")
  fullName       String         @map("full_name")
  // fullName lowercased without Vietnamese diacritics, for accent-insensitive search.
  searchName     String         @map("search_name")
  birthDate      DateTime?      @map("birth_date") @db.Date
  gender         Gender?
  phone          String?
  email          String?
  // D-016: from the "departments" and "jobTitles" lists; "Khác" with a note.
  departmentId   String?        @map("department_option_id") @db.Uuid
  department     Option?        @relation("EmployeeDepartment", fields: [departmentId], references: [id], onDelete: Restrict)
  departmentNote String?        @map("department_note")
  team           String?
  titleId        String?        @map("title_option_id") @db.Uuid
  title          Option?        @relation("EmployeeTitle", fields: [titleId], references: [id], onDelete: Restrict)
  titleNote      String?        @map("title_note")
  status         EmployeeStatus @default(ACTIVE)
  // Teaches PT: on the PT calendar and bookable inside the working schedule (D-030).
  isTrainer      Boolean        @default(false) @map("is_trainer")
  // Brief §8.4: the employee's login; one employee per user.
  userId         String?        @unique @map("user_id") @db.Uuid
  user           User?          @relation(fields: [userId], references: [id], onDelete: Restrict)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  bookings Booking[]
  shifts   EmployeeShift[]
  daysOff  EmployeeDayOff[]

  @@index([branchId])
  @@index([searchName])
  @@map("employees")
}

// The weekly working pattern (brief §8.4, D-030): ISO weekday 1 (Monday) to 7, and
// minutes after midnight, end exclusive (1440 is midnight). Checks in the migration.
model EmployeeShift {
  id          String   @id @default(uuid()) @db.Uuid
  employeeId  String   @map("employee_id") @db.Uuid
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  weekday     Int      @db.SmallInt
  startMinute Int      @map("start_minute") @db.SmallInt
  endMinute   Int      @map("end_minute") @db.SmallInt

  @@index([employeeId, weekday])
  @@map("employee_shifts")
}

// A day the employee does not work, whatever the weekly pattern says.
model EmployeeDayOff {
  id         String   @id @default(uuid()) @db.Uuid
  employeeId String   @map("employee_id") @db.Uuid
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date       DateTime @db.Date
  note       String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([employeeId, date])
  @@map("employee_days_off")
}

// A schedule record, not proof that a session happened. Overlap per trainer is
// refused by the booking_trainer_no_overlap exclusion constraint (T-014), and
// scheduled_end > scheduled_start by a CHECK (BR-011); both are in migration SQL.
model Booking {
  id             String        @id @default(uuid()) @db.Uuid
  branchId       String        @map("branch_id") @db.Uuid
  branch         Branch        @relation(fields: [branchId], references: [id], onDelete: Restrict)
  customerId     String        @map("customer_id") @db.Uuid
  customer       Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  contractId     String        @map("contract_id") @db.Uuid
  contract       Contract      @relation(fields: [contractId], references: [id], onDelete: Restrict)
  // The employee who teaches the session (D-030).
  trainerId      String        @map("trainer_id") @db.Uuid
  trainer        Employee      @relation(fields: [trainerId], references: [id], onDelete: Restrict)
  scheduledStart DateTime      @map("scheduled_start") @db.Timestamptz(3)
  scheduledEnd   DateTime      @map("scheduled_end") @db.Timestamptz(3)
  status         BookingStatus @default(BOOKED)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  session Session?

  @@index([contractId, status])
  @@index([customerId])
  @@index([trainerId, scheduledStart])
  @@index([scheduledStart])
  @@index([branchId])
  @@map("bookings")
}

// Fulfillment facts of a booking, created at check-in. No status of its own (T-011):
// a contract's completed sessions are counted from booking status (T-012).
model Session {
  id            String    @id @default(uuid()) @db.Uuid
  bookingId     String    @unique @map("booking_id") @db.Uuid
  booking       Booking   @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  checkedInAt   DateTime  @map("checked_in_at") @db.Timestamptz(3)
  checkedInById String    @map("checked_in_by") @db.Uuid
  checkedInBy   User      @relation("SessionCheckedInBy", fields: [checkedInById], references: [id], onDelete: Restrict)
  completedAt   DateTime? @map("completed_at") @db.Timestamptz(3)
  completedById String?   @map("completed_by") @db.Uuid
  completedBy   User?     @relation("SessionCompletedBy", fields: [completedById], references: [id], onDelete: Restrict)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("sessions")
}

// ---------------------------------------------------------------------------
// Finance (Phase 4). Paid amount and debt are derived from payments that are not
// deleted (BR-013, D-034). Records are never edited; a mistake is deleted to the
// trash with a reason (D-035, T-047). Amount > 0 and the deletion facts are CHECKs in
// migration SQL.
// ---------------------------------------------------------------------------

model Payment {
  id               String         @id @default(uuid()) @db.Uuid
  branchId         String         @map("branch_id") @db.Uuid
  branch           Branch         @relation(fields: [branchId], references: [id], onDelete: Restrict)
  contractId       String         @map("contract_id") @db.Uuid
  contract         Contract       @relation(fields: [contractId], references: [id], onDelete: Restrict)
  amount           Decimal        @db.Decimal(14, 0)
  // D-016, D-034: from the "paymentMethods" option list.
  methodId         String         @map("method_option_id") @db.Uuid
  method           Option         @relation("PaymentMethod", fields: [methodId], references: [id], onDelete: Restrict)
  methodNote       String?        @map("method_note")
  // The gym day the money was received (T-039).
  paidOn           DateTime       @map("paid_on") @db.Date
  // D-018, D-034: counts toward the paid amount only when APPROVED.
  approvalStatus   ApprovalStatus @default(APPROVED) @map("approval_status")
  // T-015: replaying a create with the same key returns this payment.
  idempotencyKey   String         @unique @map("idempotency_key")
  createdById      String         @map("created_by") @db.Uuid
  createdBy        User           @relation("PaymentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  // Deleted to the trash (D-035, T-047): left out of lists, totals, and debt.
  deletedAt        DateTime?      @map("deleted_at") @db.Timestamptz(3)
  deletedById      String?        @map("deleted_by") @db.Uuid
  deletedBy        User?          @relation("PaymentDeletedBy", fields: [deletedById], references: [id], onDelete: Restrict)
  // From the "deleteReasons" option list (D-016, D-035).
  deleteReasonId   String?        @map("delete_reason_option_id") @db.Uuid
  deleteReason     Option?        @relation("PaymentDeleteReason", fields: [deleteReasonId], references: [id], onDelete: Restrict)
  deleteReasonNote String?        @map("delete_reason_note")

  @@index([contractId])
  @@index([paidOn])
  @@index([branchId])
  @@map("payments")
}

model CashTransaction {
  id               String              @id @default(uuid()) @db.Uuid
  branchId         String              @map("branch_id") @db.Uuid
  branch           Branch              @relation(fields: [branchId], references: [id], onDelete: Restrict)
  type             CashTransactionType
  // From "incomeCategories" or "expenseTypes", by type (D-016, D-034).
  categoryId       String              @map("category_option_id") @db.Uuid
  category         Option              @relation("CashCategory", fields: [categoryId], references: [id], onDelete: Restrict)
  categoryNote     String?             @map("category_note")
  amount           Decimal             @db.Decimal(14, 0)
  description      String?
  reference        String?
  // The gym day it happened (T-039).
  occurredOn       DateTime            @map("occurred_on") @db.Date
  // D-018, D-034: counts toward the totals only when APPROVED.
  approvalStatus   ApprovalStatus      @default(APPROVED) @map("approval_status")
  idempotencyKey   String              @unique @map("idempotency_key")
  createdById      String              @map("created_by") @db.Uuid
  createdBy        User                @relation("CashTransactionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  deletedAt        DateTime?           @map("deleted_at") @db.Timestamptz(3)
  deletedById      String?             @map("deleted_by") @db.Uuid
  deletedBy        User?               @relation("CashTransactionDeletedBy", fields: [deletedById], references: [id], onDelete: Restrict)
  deleteReasonId   String?             @map("delete_reason_option_id") @db.Uuid
  deleteReason     Option?             @relation("CashDeleteReason", fields: [deleteReasonId], references: [id], onDelete: Restrict)
  deleteReasonNote String?             @map("delete_reason_note")

  @@index([occurredOn])
  @@index([branchId])
  @@map("cash_transactions")
}

// ---------------------------------------------------------------------------
// Tasks and notifications (brief §8.2, FR-PLT-009; M1 slice 7)
// ---------------------------------------------------------------------------

// A task goes to one person or one department (D-037); a member of the department
// accepts it and becomes its assignee. Checks in the migration.
model Task {
  id                   String       @id @default(uuid()) @db.Uuid
  branchId             String       @map("branch_id") @db.Uuid
  branch               Branch       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  title                String
  description          String?
  assignerId           String       @map("assigner_id") @db.Uuid
  assigner             User         @relation("TaskAssigner", fields: [assignerId], references: [id], onDelete: Restrict)
  assigneeUserId       String?      @map("assignee_user_id") @db.Uuid
  assigneeUser         User?        @relation("TaskAssignee", fields: [assigneeUserId], references: [id], onDelete: Restrict)
  // From the "departments" list.
  assigneeDepartmentId String?      @map("assignee_department_option_id") @db.Uuid
  assigneeDepartment   Option?      @relation(fields: [assigneeDepartmentId], references: [id], onDelete: Restrict)
  dueAt                DateTime     @map("due_at") @db.Timestamptz(3)
  priority             TaskPriority @default(NORMAL)
  status               TaskStatus   @default(NEW)
  // The record the task is about: "lead", "customer", or "contract" (more with later modules).
  entityType           String?      @map("entity_type")
  entityId             String?      @map("entity_id") @db.Uuid
  // Set when the system made the task: "studio" for Báo Studio (brief §4.1), which updates its own.
  source               String?
  acceptedAt           DateTime?    @map("accepted_at") @db.Timestamptz(3)
  startedAt            DateTime?    @map("started_at") @db.Timestamptz(3)
  doneAt               DateTime?    @map("done_at") @db.Timestamptz(3)
  cancelledAt          DateTime?    @map("cancelled_at") @db.Timestamptz(3)
  // When the reminders went out, so each goes out once (worker, T-059).
  dueSoonNotifiedAt    DateTime?    @map("due_soon_notified_at") @db.Timestamptz(3)
  overdueNotifiedAt    DateTime?    @map("overdue_notified_at") @db.Timestamptz(3)
  createdAt            DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  comments TaskComment[]

  @@index([assigneeUserId, status])
  @@index([assigneeDepartmentId, status])
  @@index([assignerId, status])
  @@index([branchId])
  @@index([status, dueAt])
  @@map("tasks")
}

// Comments are never edited or deleted; they are the task's conversation.
model TaskComment {
  id        String   @id @default(uuid()) @db.Uuid
  taskId    String   @map("task_id") @db.Uuid
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Restrict)
  authorId  String   @map("author_id") @db.Uuid
  author    User     @relation(fields: [authorId], references: [id], onDelete: Restrict)
  body      String
  // Users named in the comment; each was notified.
  mentions  String[] @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([taskId, createdAt])
  @@map("task_comments")
}

// One user's in-app notification. The kind and params are turned into text by the
// web app in the user's language.
model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String
  params    Json      @default("{}")
  link      String?
  readAt    DateTime? @map("read_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([userId, createdAt])
  @@map("notifications")
}
