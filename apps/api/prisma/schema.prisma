// Data model: docs/04_DATA_MODEL_ERD.md
// Tables and columns are snake_case so raw SQL (row locks, constraints) stays readable.
// All datetime columns are timestamptz (docs/04 "Time").

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  // ES modules with .js import paths, as Node.js and `tsc --module nodenext` expect.
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// D-017: a role's reach per resource: everything in the user's branches, or only the
// records the user is responsible for.
enum DataScope {
  ALL
  OWN
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum Locale {
  vi
  en
}

// Stored contract statuses; EXPIRED is derived from end_date (T-018).
enum ContractStatus {
  DRAFT
  ACTIVE
  CANCELLED
}

// A-013
enum CustomerStatus {
  ACTIVE
  INACTIVE
}

// Working status (brief §8.4): an employee who left keeps their history but takes no
// new bookings.
enum EmployeeStatus {
  ACTIVE
  INACTIVE
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

// The booking owns the single lifecycle status (T-011).
enum BookingStatus {
  BOOKED
  CHECKED_IN
  COMPLETED
  CANCELLED
  NO_SHOW
}

// D-018: a request moves from PENDING to APPROVED or REJECTED by someone other than
// its submitter, or is CANCELLED when its record goes away. Records that can need
// approval use PENDING, APPROVED, and REJECTED, and count only when APPROVED.
enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum CashTransactionType {
  INCOME
  EXPENSE
}

// ---------------------------------------------------------------------------
// Identity. The User, AuthSession, AuthAccount, AuthVerification and
// AuthRateLimit shapes are dictated by Better Auth (T-028).
// ---------------------------------------------------------------------------

model User {
  id            String     @id @default(uuid()) @db.Uuid
  name          String
  email         String     @unique
  emailVerified Boolean    @default(false) @map("email_verified")
  image         String?
  roleId        String     @map("role_id") @db.Uuid
  role          Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  // D-014: every branch, including ones created later; otherwise the granted branches.
  allBranches   Boolean    @default(false) @map("all_branches")
  status        UserStatus @default(ACTIVE)
  locale        Locale     @default(vi)
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions           AuthSession[]
  accounts           AuthAccount[]
  auditEvents        AuditEvent[]
  contractsCreated   Contract[]
  // Brief §8.4: the employee this login belongs to, at most one.
  employee           Employee?
  sessionsCheckedIn  Session[]                @relation("SessionCheckedInBy")
  sessionsCompleted  Session[]                @relation("SessionCompletedBy")
  paymentsRecorded   Payment[]                @relation("PaymentCreatedBy")
  paymentsDeleted    Payment[]                @relation("PaymentDeletedBy")
  cashRecorded       CashTransaction[]        @relation("CashTransactionCreatedBy")
  cashDeleted        CashTransaction[]        @relation("CashTransactionDeletedBy")
  trashEntries       TrashEntry[]
  approvalsSubmitted ApprovalRequest[]        @relation("ApprovalSubmittedBy")
  approvalsDecided   ApprovalRequest[]        @relation("ApprovalDecidedBy")
  customersCreated   Customer[]
  branches           UserBranch[]
  overrides          UserPermissionOverride[]
  accessWindows      UserAccessWindow[]
  loginEvents        LoginEvent[]

  @@index([roleId])
  @@map("users")
}

// ---------------------------------------------------------------------------
// Branches, roles, and permissions (D-014, D-017, T-046). Permission keys, data-scope
// resources, and maskable fields are a catalog in @flow/shared; rows here configure them.
// ---------------------------------------------------------------------------

model Branch {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  address   String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  users            UserBranch[]
  customers        Customer[]
  contracts        Contract[]
  employees        Employee[]
  bookings         Booking[]
  payments         Payment[]
  cashTransactions CashTransaction[]
  trashEntries     TrashEntry[]
  approvalRequests ApprovalRequest[]

  @@map("branches")
}

model Role {
  id           String   @id @default(uuid()) @db.Uuid
  // Set on the default roles (09_RBAC.md) so code and tests can find them; null for
  // roles admin creates. Never shown to users.
  code         String?  @unique
  name         String   @unique
  description  String?
  clonedFromId String?  @map("cloned_from_id") @db.Uuid
  clonedFrom   Role?    @relation("RoleClones", fields: [clonedFromId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  clones        Role[]             @relation("RoleClones")
  users         User[]
  approvalRules ApprovalRuleRole[]
  permissions   RolePermission[]
  dataScopes    RoleDataScope[]
  fieldMasks    RoleFieldMask[]

  @@map("roles")
}

model RolePermission {
  roleId     String @map("role_id") @db.Uuid
  role       Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission String

  @@id([roleId, permission])
  @@map("role_permissions")
}

// A resource without a row is OWN: a new resource is closed until admin opens it.
model RoleDataScope {
  roleId   String    @map("role_id") @db.Uuid
  role     Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  resource String
  scope    DataScope

  @@id([roleId, resource])
  @@map("role_data_scopes")
}

model RoleFieldMask {
  roleId String @map("role_id") @db.Uuid
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  field  String

  @@id([roleId, field])
  @@map("role_field_masks")
}

// A user inherits the role and can have single permissions switched on or off.
model UserPermissionOverride {
  userId     String  @map("user_id") @db.Uuid
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission String
  granted    Boolean

  @@id([userId, permission])
  @@map("user_permission_overrides")
}

model UserBranch {
  userId   String @map("user_id") @db.Uuid
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branchId String @map("branch_id") @db.Uuid
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@id([userId, branchId])
  @@map("user_branches")
}

// Allowed sign-in days and times in the gym timezone (D-017). No rows: any time.
model UserAccessWindow {
  id        String @id @default(uuid()) @db.Uuid
  userId    String @map("user_id") @db.Uuid
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  // ISO weekdays, 1 = Monday … 7 = Sunday.
  weekdays  Int[]
  startTime String @map("start_time")
  endTime   String @map("end_time")

  @@index([userId])
  @@map("user_access_windows")
}

// Every sign-in attempt (D-017). Insert-only.
model LoginEvent {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  email     String
  success   Boolean
  // Why a sign-in failed: WRONG_PASSWORD, UNKNOWN_USER, DISABLED, OUTSIDE_HOURS, RATE_LIMITED.
  reason    String?
  ip        String?
  userAgent String?  @map("user_agent")
  at        DateTime @default(now()) @db.Timestamptz(3)

  @@index([userId, at])
  @@map("login_history")
}

// ---------------------------------------------------------------------------
// Configuration (T-049): values admin changes on screen; the flows stay in code.
// ---------------------------------------------------------------------------

// One option of an option list (D-016). The list keys are code (packages/shared);
// options are never deleted, only made inactive, so old records keep theirs. One
// "Khác" per list (partial unique index in migration SQL), which needs a note.
model Option {
  id        String   @id @default(uuid()) @db.Uuid
  listKey   String   @map("list_key")
  labelVi   String   @map("label_vi")
  labelEn   String   @map("label_en")
  sortOrder Int      @map("sort_order")
  active    Boolean  @default(true)
  isOther   Boolean  @default(false) @map("is_other")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  paymentMethods       Payment[]         @relation("PaymentMethod")
  paymentDeleteReasons Payment[]         @relation("PaymentDeleteReason")
  cashCategories       CashTransaction[] @relation("CashCategory")
  cashDeleteReasons    CashTransaction[] @relation("CashDeleteReason")
  trashEntries         TrashEntry[]
  approvalRejections   ApprovalRequest[]
  employeeDepartments  Employee[]        @relation("EmployeeDepartment")
  employeeTitles       Employee[]        @relation("EmployeeTitle")

  @@unique([listKey, labelVi])
  @@index([listKey, sortOrder])
  @@map("options")
}

// A system parameter (T-049). Keys and defaults are code (packages/shared); a missing
// row means the default.
model SystemParameter {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("system_parameters")
}

model AuthSession {
  id        String   @id @default(uuid()) @db.Uuid
  token     String   @unique
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([userId])
  @@map("auth_sessions")
}

model AuthAccount {
  id                    String    @id @default(uuid()) @db.Uuid
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id") @db.Uuid
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([userId])
  @@map("auth_accounts")
}

model AuthVerification {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([identifier])
  @@map("auth_verifications")
}

model AuthRateLimit {
  id          String @id @default(uuid()) @db.Uuid
  key         String @unique
  count       Int
  lastRequest BigInt @map("last_request")

  @@map("auth_rate_limits")
}

// ---------------------------------------------------------------------------
// Audit (T-022): written in the same transaction as the change it describes.
// ---------------------------------------------------------------------------

model AuditEvent {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  actor       User?    @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  entityType  String   @map("entity_type")
  entityId    String   @map("entity_id") @db.Uuid
  action      String
  // T-048: the record's values before and after the change; null for a create
  // (before) or a delete (after). Updates hold the changed fields only.
  before      Json?
  after       Json?
  // What else explains the change, e.g. a reason or the contract it belongs to.
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([entityType, entityId])
  @@index([actorUserId])
  @@index([createdAt])
  @@map("audit_events")
}

// The trash (D-035, T-047): one entry per deleted record, kept forever with the
// record as it was. The application has no path to change or remove an entry.
model TrashEntry {
  id          String   @id @default(uuid()) @db.Uuid
  entityType  String   @map("entity_type")
  entityId    String   @map("entity_id") @db.Uuid
  branchId    String   @map("branch_id") @db.Uuid
  branch      Branch   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  // A short name and amount for lists; the full record is in the snapshot.
  title       String
  amount      Decimal? @db.Decimal(14, 0)
  snapshot    Json
  reasonId    String   @map("reason_option_id") @db.Uuid
  reason      Option   @relation(fields: [reasonId], references: [id], onDelete: Restrict)
  reasonNote  String?  @map("reason_note")
  deletedById String   @map("deleted_by") @db.Uuid
  deletedBy   User     @relation(fields: [deletedById], references: [id], onDelete: Restrict)
  deletedAt   DateTime @map("deleted_at") @db.Timestamptz(3)

  @@unique([entityType, entityId])
  @@index([deletedAt])
  @@map("trash_entries")
}

// ---------------------------------------------------------------------------
// Approvals (D-018): the matrix and the requests. Action keys are code
// (packages/shared/approvals); which need approval and who approves is configuration.
// ---------------------------------------------------------------------------

model ApprovalRule {
  // An id of its own so the audit log can key the rule's history (T-048).
  id           String             @id @default(uuid()) @db.Uuid
  actionType   String             @unique @map("action_type")
  required     Boolean
  overdueHours Int                @map("overdue_hours")
  updatedAt    DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  approvers    ApprovalRuleRole[]

  @@map("approval_rules")
}

model ApprovalRuleRole {
  actionType String       @map("action_type")
  rule       ApprovalRule @relation(fields: [actionType], references: [actionType], onDelete: Cascade)
  roleId     String       @map("role_id") @db.Uuid
  role       Role         @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([actionType, roleId])
  @@map("approval_rule_roles")
}

// One request per submission. The decider is never the submitter, one PENDING request
// per record and action, and the decision facts are complete: CHECKs and a partial
// unique index in migration SQL.
model ApprovalRequest {
  id               String         @id @default(uuid()) @db.Uuid
  actionType       String         @map("action_type")
  entityType       String         @map("entity_type")
  entityId         String         @map("entity_id") @db.Uuid
  branchId         String         @map("branch_id") @db.Uuid
  branch           Branch         @relation(fields: [branchId], references: [id], onDelete: Restrict)
  title            String
  amount           Decimal?       @db.Decimal(14, 0)
  // What approval applies, e.g. a customer's new phone, or a deletion's reason.
  payload          Json           @default("{}")
  status           ApprovalStatus @default(PENDING)
  submittedById    String         @map("submitted_by") @db.Uuid
  submittedBy      User           @relation("ApprovalSubmittedBy", fields: [submittedById], references: [id], onDelete: Restrict)
  submittedAt      DateTime       @default(now()) @map("submitted_at") @db.Timestamptz(3)
  decidedById      String?        @map("decided_by") @db.Uuid
  decidedBy        User?          @relation("ApprovalDecidedBy", fields: [decidedById], references: [id], onDelete: Restrict)
  decidedAt        DateTime?      @map("decided_at") @db.Timestamptz(3)
  rejectReasonId   String?        @map("reject_reason_option_id") @db.Uuid
  rejectReason     Option?        @relation(fields: [rejectReasonId], references: [id], onDelete: Restrict)
  rejectReasonNote String?        @map("reject_reason_note")

  @@index([status, actionType])
  @@index([entityId])
  @@map("approval_requests")
}

// ---------------------------------------------------------------------------
// Customers
// ---------------------------------------------------------------------------

model Customer {
  id           String         @id @default(uuid()) @db.Uuid
  branchId     String         @map("branch_id") @db.Uuid
  branch       Branch         @relation(fields: [branchId], references: [id], onDelete: Restrict)
  // Generated from the customer_code_seq sequence (T-019, A-003). Never updated.
  customerCode String         @unique @map("customer_code")
  fullName     String         @map("full_name")
  // fullName lowercased without Vietnamese diacritics, for accent-insensitive search.
  searchName   String         @map("search_name")
  phone        String
  email        String?
  dateOfBirth  DateTime?      @map("date_of_birth") @db.Date
  status       CustomerStatus @default(ACTIVE)
  notes        String?
  // D-017 data scope "own" (A-029); null for customers created before it was recorded.
  createdById  String?        @map("created_by") @db.Uuid
  createdBy    User?          @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  contracts Contract[]
  bookings  Booking[]

  @@index([phone])
  @@index([searchName])
  @@index([branchId])
  @@map("customers")
}

// ---------------------------------------------------------------------------
// Contracts. Derived values (completed/remaining sessions, paid, debt, EXPIRED)
// are computed, never stored (T-012, T-018, BR-013).
// ---------------------------------------------------------------------------

model Contract {
  id                  String         @id @default(uuid()) @db.Uuid
  branchId            String         @map("branch_id") @db.Uuid
  branch              Branch         @relation(fields: [branchId], references: [id], onDelete: Restrict)
  // Generated from the contract_code_seq sequence (T-019, A-003). Never updated.
  contractCode        String         @unique @map("contract_code")
  customerId          String         @map("customer_id") @db.Uuid
  customer            Customer       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  packageName         String         @map("package_name")
  contractValue       Decimal        @map("contract_value") @db.Decimal(14, 0)
  totalSessions       Int            @map("total_sessions")
  // Opening balances (D-011): non-zero only for contracts imported at go-live.
  openingSessionsUsed Int            @default(0) @map("opening_sessions_used")
  openingPaidAmount   Decimal        @default(0) @map("opening_paid_amount") @db.Decimal(14, 0)
  startDate           DateTime       @map("start_date") @db.Date
  endDate             DateTime       @map("end_date") @db.Date
  status              ContractStatus @default(DRAFT)
  // T-015: replaying a create with the same key returns this contract.
  idempotencyKey      String         @unique @map("idempotency_key")
  createdById         String         @map("created_by") @db.Uuid
  createdBy           User           @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt           DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  bookings Booking[]
  payments Payment[]

  @@index([customerId])
  @@index([branchId])
  @@map("contracts")
}

// ---------------------------------------------------------------------------
// Employees (M1 slice 6), bookings, and sessions (Phase 3).
// ---------------------------------------------------------------------------

model Employee {
  id             String         @id @default(uuid()) @db.Uuid
  branchId       String         @map("branch_id") @db.Uuid
  branch         Branch         @relation(fields: [branchId], references: [id], onDelete: Restrict)
  // Generated from the employee_code_seq sequence (T-019, D-038). Never updated.
  employeeCode   String         @unique @map("employee_code")
  fullName       String         @map("full_name")
  // fullName lowercased without Vietnamese diacritics, for accent-insensitive search.
  searchName     String         @map("search_name")
  birthDate      DateTime?      @map("birth_date") @db.Date
  gender         Gender?
  phone          String?
  email          String?
  // D-016: from the "departments" and "jobTitles" lists; "Khác" with a note.
  departmentId   String?        @map("department_option_id") @db.Uuid
  department     Option?        @relation("EmployeeDepartment", fields: [departmentId], references: [id], onDelete: Restrict)
  departmentNote String?        @map("department_note")
  team           String?
  titleId        String?        @map("title_option_id") @db.Uuid
  title          Option?        @relation("EmployeeTitle", fields: [titleId], references: [id], onDelete: Restrict)
  titleNote      String?        @map("title_note")
  status         EmployeeStatus @default(ACTIVE)
  // Teaches PT: on the PT calendar and bookable inside the working schedule (D-030).
  isTrainer      Boolean        @default(false) @map("is_trainer")
  // Brief §8.4: the employee's login; one employee per user.
  userId         String?        @unique @map("user_id") @db.Uuid
  user           User?          @relation(fields: [userId], references: [id], onDelete: Restrict)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  bookings Booking[]
  shifts   EmployeeShift[]
  daysOff  EmployeeDayOff[]

  @@index([branchId])
  @@index([searchName])
  @@map("employees")
}

// The weekly working pattern (brief §8.4, D-030): ISO weekday 1 (Monday) to 7, and
// minutes after midnight, end exclusive (1440 is midnight). Checks in the migration.
model EmployeeShift {
  id          String   @id @default(uuid()) @db.Uuid
  employeeId  String   @map("employee_id") @db.Uuid
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  weekday     Int      @db.SmallInt
  startMinute Int      @map("start_minute") @db.SmallInt
  endMinute   Int      @map("end_minute") @db.SmallInt

  @@index([employeeId, weekday])
  @@map("employee_shifts")
}

// A day the employee does not work, whatever the weekly pattern says.
model EmployeeDayOff {
  id         String   @id @default(uuid()) @db.Uuid
  employeeId String   @map("employee_id") @db.Uuid
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date       DateTime @db.Date
  note       String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([employeeId, date])
  @@map("employee_days_off")
}

// A schedule record, not proof that a session happened. Overlap per trainer is
// refused by the booking_trainer_no_overlap exclusion constraint (T-014), and
// scheduled_end > scheduled_start by a CHECK (BR-011); both are in migration SQL.
model Booking {
  id             String        @id @default(uuid()) @db.Uuid
  branchId       String        @map("branch_id") @db.Uuid
  branch         Branch        @relation(fields: [branchId], references: [id], onDelete: Restrict)
  customerId     String        @map("customer_id") @db.Uuid
  customer       Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  contractId     String        @map("contract_id") @db.Uuid
  contract       Contract      @relation(fields: [contractId], references: [id], onDelete: Restrict)
  // The employee who teaches the session (D-030).
  trainerId      String        @map("trainer_id") @db.Uuid
  trainer        Employee      @relation(fields: [trainerId], references: [id], onDelete: Restrict)
  scheduledStart DateTime      @map("scheduled_start") @db.Timestamptz(3)
  scheduledEnd   DateTime      @map("scheduled_end") @db.Timestamptz(3)
  status         BookingStatus @default(BOOKED)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  session Session?

  @@index([contractId, status])
  @@index([customerId])
  @@index([trainerId, scheduledStart])
  @@index([scheduledStart])
  @@index([branchId])
  @@map("bookings")
}

// Fulfillment facts of a booking, created at check-in. No status of its own (T-011):
// a contract's completed sessions are counted from booking status (T-012).
model Session {
  id            String    @id @default(uuid()) @db.Uuid
  bookingId     String    @unique @map("booking_id") @db.Uuid
  booking       Booking   @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  checkedInAt   DateTime  @map("checked_in_at") @db.Timestamptz(3)
  checkedInById String    @map("checked_in_by") @db.Uuid
  checkedInBy   User      @relation("SessionCheckedInBy", fields: [checkedInById], references: [id], onDelete: Restrict)
  completedAt   DateTime? @map("completed_at") @db.Timestamptz(3)
  completedById String?   @map("completed_by") @db.Uuid
  completedBy   User?     @relation("SessionCompletedBy", fields: [completedById], references: [id], onDelete: Restrict)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("sessions")
}

// ---------------------------------------------------------------------------
// Finance (Phase 4). Paid amount and debt are derived from payments that are not
// deleted (BR-013, D-034). Records are never edited; a mistake is deleted to the
// trash with a reason (D-035, T-047). Amount > 0 and the deletion facts are CHECKs in
// migration SQL.
// ---------------------------------------------------------------------------

model Payment {
  id               String         @id @default(uuid()) @db.Uuid
  branchId         String         @map("branch_id") @db.Uuid
  branch           Branch         @relation(fields: [branchId], references: [id], onDelete: Restrict)
  contractId       String         @map("contract_id") @db.Uuid
  contract         Contract       @relation(fields: [contractId], references: [id], onDelete: Restrict)
  amount           Decimal        @db.Decimal(14, 0)
  // D-016, D-034: from the "paymentMethods" option list.
  methodId         String         @map("method_option_id") @db.Uuid
  method           Option         @relation("PaymentMethod", fields: [methodId], references: [id], onDelete: Restrict)
  methodNote       String?        @map("method_note")
  // The gym day the money was received (T-039).
  paidOn           DateTime       @map("paid_on") @db.Date
  // D-018, D-034: counts toward the paid amount only when APPROVED.
  approvalStatus   ApprovalStatus @default(APPROVED) @map("approval_status")
  // T-015: replaying a create with the same key returns this payment.
  idempotencyKey   String         @unique @map("idempotency_key")
  createdById      String         @map("created_by") @db.Uuid
  createdBy        User           @relation("PaymentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  // Deleted to the trash (D-035, T-047): left out of lists, totals, and debt.
  deletedAt        DateTime?      @map("deleted_at") @db.Timestamptz(3)
  deletedById      String?        @map("deleted_by") @db.Uuid
  deletedBy        User?          @relation("PaymentDeletedBy", fields: [deletedById], references: [id], onDelete: Restrict)
  // From the "deleteReasons" option list (D-016, D-035).
  deleteReasonId   String?        @map("delete_reason_option_id") @db.Uuid
  deleteReason     Option?        @relation("PaymentDeleteReason", fields: [deleteReasonId], references: [id], onDelete: Restrict)
  deleteReasonNote String?        @map("delete_reason_note")

  @@index([contractId])
  @@index([paidOn])
  @@index([branchId])
  @@map("payments")
}

model CashTransaction {
  id               String              @id @default(uuid()) @db.Uuid
  branchId         String              @map("branch_id") @db.Uuid
  branch           Branch              @relation(fields: [branchId], references: [id], onDelete: Restrict)
  type             CashTransactionType
  // From "incomeCategories" or "expenseTypes", by type (D-016, D-034).
  categoryId       String              @map("category_option_id") @db.Uuid
  category         Option              @relation("CashCategory", fields: [categoryId], references: [id], onDelete: Restrict)
  categoryNote     String?             @map("category_note")
  amount           Decimal             @db.Decimal(14, 0)
  description      String?
  reference        String?
  // The gym day it happened (T-039).
  occurredOn       DateTime            @map("occurred_on") @db.Date
  // D-018, D-034: counts toward the totals only when APPROVED.
  approvalStatus   ApprovalStatus      @default(APPROVED) @map("approval_status")
  idempotencyKey   String              @unique @map("idempotency_key")
  createdById      String              @map("created_by") @db.Uuid
  createdBy        User                @relation("CashTransactionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  deletedAt        DateTime?           @map("deleted_at") @db.Timestamptz(3)
  deletedById      String?             @map("deleted_by") @db.Uuid
  deletedBy        User?               @relation("CashTransactionDeletedBy", fields: [deletedById], references: [id], onDelete: Restrict)
  deleteReasonId   String?             @map("delete_reason_option_id") @db.Uuid
  deleteReason     Option?             @relation("CashDeleteReason", fields: [deleteReasonId], references: [id], onDelete: Restrict)
  deleteReasonNote String?             @map("delete_reason_note")

  @@index([occurredOn])
  @@index([branchId])
  @@map("cash_transactions")
}
