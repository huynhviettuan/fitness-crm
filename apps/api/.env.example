# Copy to apps/api/.env for local development: cp apps/api/.env.example apps/api/.env
# Every value here is for LOCAL DEVELOPMENT ONLY. Never use them in a deployed environment.

# Databases (docker-compose.yml)
DATABASE_URL="postgresql://fitness:fitness@localhost:5432/fitness_crm"
TEST_DATABASE_URL="postgresql://fitness:fitness@localhost:5432/fitness_crm_test"
E2E_DATABASE_URL="postgresql://fitness:fitness@localhost:5432/fitness_crm_e2e"

# API port; the web app reaches it at its API_URL.
PORT="4000"

# Better Auth (T-028). Generate a new secret per environment: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-a-generated-secret"

# D-042, T-052: encrypts ID numbers and health notes (AES-256-GCM). 32 random bytes, base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# One per environment. Losing it makes those fields unreadable; never commit a real one.
FIELD_ENCRYPTION_KEY="replace-with-a-generated-key"
# The web app's public URL: browsers reach the API through it (T-053).
BETTER_AUTH_URL="http://localhost:3000"

# Gym timezone (A-001)
GYM_TIMEZONE="Asia/Ho_Chi_Minh"
LOG_LEVEL="info"

# Background jobs (T-059): reminders run inside the API in development. In production set
# RUN_JOBS="false" here and run the worker: node dist/worker.js
RUN_JOBS="true"

# Customer email (D-036, T-051). "log" only records that an email would go out (development, tests). In a deployed
# environment use "resend" with a key and a sender on the domain authenticated with SPF, DKIM and DMARC:
#   EMAIL_PROVIDER="resend"
#   EMAIL_FROM="Flow Fitness <noreply@your-domain>"
#   RESEND_API_KEY="re_..."
EMAIL_PROVIDER="log"

# First admin account, created by: pnpm db:seed (local development only)
SEED_ADMIN_EMAIL="admin@fitness-crm.test"
SEED_ADMIN_PASSWORD="Dev-a5c624277a0c"
SEED_ADMIN_NAME="Quản trị viên"

# Private file storage (T-052): "local" keeps files under FILE_STORAGE_DIR; "r2" uses Cloudflare R2.
FILE_STORAGE="local"
# FILE_STORAGE_DIR=".data/files"
#   FILE_STORAGE="r2"
#   R2_ACCOUNT_ID=""
#   R2_ACCESS_KEY_ID=""
#   R2_SECRET_ACCESS_KEY=""
#   R2_BUCKET=""
