# Copy to .env for local development: cp .env.example .env
# Every value here is for LOCAL DEVELOPMENT ONLY. Never use them in a deployed environment.

# Databases (docker-compose.yml)
DATABASE_URL="postgresql://fitness:fitness@localhost:5432/fitness_crm"
TEST_DATABASE_URL="postgresql://fitness:fitness@localhost:5432/fitness_crm_test"
E2E_DATABASE_URL="postgresql://fitness:fitness@localhost:5432/fitness_crm_e2e"

# Better Auth (T-028). Generate a new secret per environment: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-a-generated-secret"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Gym timezone (A-001)
GYM_TIMEZONE="Asia/Ho_Chi_Minh"
LOG_LEVEL="info"

# Hours the PT calendar shows by default; bookings outside them are still shown.
SCHEDULE_START_HOUR="6"
SCHEDULE_END_HOUR="22"

# First admin account, created by: npm run db:seed (local development only)
SEED_ADMIN_EMAIL="admin@fitness-crm.test"
SEED_ADMIN_PASSWORD="Dev-a5c624277a0c"
SEED_ADMIN_NAME="Quản trị viên"
